                <label style="margin: 0; font-size: 11px; color: var(--text-muted); font-weight: 600;">Ảnh nền minh họa</label>
                <div style="display: flex; align-items: center; gap: 8px; width: 100%;">
                    <select class="feature-image-select" style="min-height: 34px; padding: 0 8px; font-size: 12px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-sm); flex: 1;">
