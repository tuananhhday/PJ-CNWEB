<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Admin' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/admin.css?v=admin-mobile-20260603">
</head>

<body>
    <% const vehicleTypeLabel={ Pickup: 'Xe bán tải' , Convertible: 'Xe mui trần' }; const
        displayVehicleType=(typeName)=> vehicleTypeLabel[typeName] || typeName;
        const vehicleTypeOrder = ['Sedan', 'SUV', 'Crossover', 'Hatchback', 'MPV', 'Pickup', 'Coupe', 'Convertible'];
        const modelMap = new Map();
        (models || []).forEach((model) => {
        const typeName = model.ten_loai || model.ten_dong || 'Khác';
        if (!modelMap.has(typeName)) modelMap.set(typeName, { ...model, ten_loai: typeName });
        });
        const uniqueModels = Array.from(modelMap.values()).sort((a, b) => {
        const aIndex = vehicleTypeOrder.indexOf(a.ten_loai);
        const bIndex = vehicleTypeOrder.indexOf(b.ten_loai);
        if (aIndex !== -1 || bIndex !== -1) {
        return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
        }
        return String(a.ten_loai).localeCompare(String(b.ten_loai));
        });
        %>
        <script>
            const allImageFiles = <%- JSON.stringify(imageFiles || []) %>;
            const allBo360Sets = <%- JSON.stringify(bo360Sets || []) %>;
        </script>
        <main class="admin-page">
            <aside class="admin-sidebar">
                <a class="admin-brand" href="/trang-chu">Showroom</a>
                <a href="/admin/dai-ly">Quản lý đại lý</a>
                <a href="/admin/tin-tuc">Quản lý tin tức</a>
                <a class="is-active" href="/admin/xe">Quản lý xe</a>
                <a href="/admin/anh-360">📸 Bộ ảnh 360°</a>
                <a href="/admin/yeu-cau">Báo giá / Lái thử</a>
                <a href="/admin/panel">Quản lý panel</a>
                <a href="/trang-chu">Xem trang chủ</a>
            </aside>

            <section class="admin-content">
                <div class="admin-heading">
                    <div>
                        <p>Admin</p>
                        <h1>Quản lý nội dung</h1>
                    </div>
                    <a href="/trang-chu">Mở trang chủ</a>
                </div>

                <% if (success) { %>
                    <div class="admin-alert success">
                        <%= success %>
                    </div>
                    <% } %>
                        <% if (error) { %>
                            <div class="admin-alert error">
                                <%= error %>
                            </div>
                            <% } %>

                                <form class="admin-form car-live-editor" action="/admin/xe/them" method="post"
                                    enctype="multipart/form-data" data-preview-url="/xe">
                                    <h2>Thêm thông tin xe</h2>
                                    <div class="car-editor-fields">

                                        <!-- Nhóm 1: Thông tin cơ bản -->
                                        <div class="form-group-card"
                                            style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; background: #ffffff; box-shadow: var(--shadow-sm);">
                                            <h3
                                                style="font-size: 15px; font-weight: 700; color: var(--text-dark); margin: 0 0 20px 0; border-bottom: 1.5px solid var(--primary-glow); padding-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                                                📄 Thông tin cơ bản
                                            </h3>
                                            <div class="admin-form-grid">
                                                <label>
                                                    Kiểu dáng xe
                                                    <select name="dong_xe_id" required>
                                                        <option value="">Chọn kiểu dáng xe</option>
                                                        <% uniqueModels.forEach((model)=> { %>
                                                            <option value="<%= model.id %>">
                                                                <%= displayVehicleType(model.ten_loai) %>
                                                            </option>
                                                            <% }) %>
                                                    </select>
                                                </label>
                                                <label>
                                                    Tên xe
                                                    <input name="ten_xe" required placeholder="Ford Everest Platinum">
                                                    <small
                                                        style="color: var(--text-muted); font-weight: normal; margin-top: 4px; display: block; line-height: 1.4;">Mẹo:
                                                        Nhập trùng tên xe (vd: <b>Ford Everest</b>) để hệ thống tự động
                                                        gom chúng thành các phiên bản của nhau.</small>
                                                </label>
                                                <label>
                                                    Phiên bản
                                                    <input name="phien_ban" placeholder="Platinum">
                                                    <small
                                                        style="color: var(--text-muted); font-weight: normal; margin-top: 4px; display: block; line-height: 1.4;">Ví
                                                        dụ: Sport, Titanium, Platinum. Mỗi phiên bản sẽ là một xe riêng
                                                        biệt có giá và thông số riêng.</small>
                                                </label>
                                                <label>
                                                    Năm sản xuất
                                                    <input name="nam_san_xuat" type="number" placeholder="2026">
                                                </label>
                                                <label>
                                                    Giá bán
                                                    <input name="gia_ban" type="number" required
                                                        placeholder="1545000000">
                                                </label>
                                                <label>
                                                    Giá niêm yết
                                                    <input name="gia_niem_yet" type="number" placeholder="1545000000">
                                                </label>
                                                <label>
                                                    Số lượng tồn
                                                    <input name="so_luong_ton" type="number" value="1">
                                                </label>
                                                <label>
                                                    Xuất xứ
                                                    <input name="xuat_xu" placeholder="Thái Lan">
                                                </label>
                                                <label style="grid-column: span 2;">
                                                    Bảo hành
                                                    <input name="bao_hanh" placeholder="3 năm hoặc 100.000 km">
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Nhóm 2: Thông số vận hành & mô tả -->
                                        <div class="form-group-card"
                                            style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; background: #ffffff; box-shadow: var(--shadow-sm);">
                                            <h3
                                                style="font-size: 15px; font-weight: 700; color: var(--text-dark); margin: 0 0 20px 0; border-bottom: 1.5px solid var(--primary-glow); padding-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                                                ⚙️ Thông số vận hành & Mô tả
                                            </h3>
                                            <div class="admin-form-grid">
                                                <label>
                                                    Động cơ
                                                    <input name="dong_co" placeholder="2.0L Turbo Diesel">
                                                </label>
                                                <label>
                                                    Hộp số
                                                    <input name="hop_so" placeholder="Tự động 10 cấp">
                                                </label>
                                                <label>
                                                    Nhiên liệu
                                                    <select name="nhien_lieu">
                                                        <option value="xang">Xăng</option>
                                                        <option value="dau">Dầu</option>
                                                        <option value="dien">Điện</option>
                                                        <option value="hybrid">Hybrid</option>
                                                    </select>
                                                </label>
                                                <label>
                                                    Số chỗ ngồi
                                                    <input name="so_cho_ngoi" type="number" placeholder="7">
                                                </label>
                                                <label>
                                                    Link E Book
                                                    <input name="ebook_url" placeholder="https://...">
                                                </label>
                                                <label>
                                                    Link E Brochure
                                                    <input name="brochure_url" placeholder="https://...">
                                                </label>
                                                <label style="grid-column: span 2;">
                                                    Mô tả ngắn
                                                    <input name="mo_ta_ngan"
                                                        placeholder="SUV 7 chỗ hạng sang, mạnh mẽ và hiện đại">
                                                </label>
                                                <label style="grid-column: span 2;">
                                                    Mô tả chi tiết
                                                    <textarea name="mo_ta_chi_tiet" rows="4"
                                                        placeholder="Viết nội dung giới thiệu xe..."></textarea>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Nhóm 3: Thư viện & Ảnh 360 -->
                                        <div class="form-group-card"
                                            style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; background: #ffffff; box-shadow: var(--shadow-sm);">
                                            <h3
                                                style="font-size: 15px; font-weight: 700; color: var(--text-dark); margin: 0 0 20px 0; border-bottom: 1.5px solid var(--primary-glow); padding-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                                                🖼️ Thư viện hình ảnh & Ảnh 360°
                                            </h3>
                                            <div class="admin-form-grid" style="margin-bottom: 20px;">
                                                <label style="grid-column: span 2;">
                                                    Ảnh đại diện
                                                    <input name="anh_dai_dien" type="file" accept="image/*">
                                                    <small>Chọn ảnh từ máy, hệ thống tự lưu vào thư mục images.</small>
                                                </label>
                                            </div>

                                            <div id="add-car-images-exterior" class="admin-dynamic-upload-block"
                                                style="display: grid; gap: 16px; margin-bottom: 12px; padding: 16px; background: #f8fafc; border: 1px dashed var(--border-color); border-radius: var(--radius-sm);">
                                                <label style="margin-bottom: 0;">
                                                    Danh sách ảnh Ngoại thất
                                                    <input name="anh_ngoai_that" type="file" accept="image/*" multiple onchange="handleFileSelectPreview(this)">
                                                    <small>Mẹo: Chọn ảnh để xem trước và nhập chú thích của từng ảnh ngay lập tức.</small>
                                                </label>
                                            </div>
                                            <button type="button" class="btn secondary"
                                                style="width: fit-content; margin-bottom: 24px;"
                                                onclick="addFileInput('add-car-images-exterior', 'anh_ngoai_that', 'Ảnh ngoại thất')">+
                                                Thêm ô ảnh Ngoại thất</button>

                                            <div id="add-car-images-interior" class="admin-dynamic-upload-block"
                                                style="display: grid; gap: 16px; margin-bottom: 12px; padding: 16px; background: #f8fafc; border: 1px dashed var(--border-color); border-radius: var(--radius-sm);">
                                                <label style="margin-bottom: 0;">
                                                    Danh sách ảnh Nội thất
                                                    <input name="anh_noi_that" type="file" accept="image/*" multiple onchange="handleFileSelectPreview(this)">
                                                    <small>Mẹo: Chọn ảnh để xem trước và nhập chú thích của từng ảnh ngay lập tức.</small>
                                                </label>
                                            </div>
                                            <button type="button" class="btn secondary"
                                                style="width: fit-content; margin-bottom: 24px;"
                                                onclick="addFileInput('add-car-images-interior', 'anh_noi_that', 'Ảnh nội thất')">+
                                                Thêm ô ảnh Nội thất</button>

                                            <!-- Bộ ảnh 360 độ mặc định liên kết -->
                                            <div class="default-360-inner-section"
                                                style="border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: 20px;">
                                                <label
                                                    style="font-weight: 700; font-size: 14px; color: var(--text-dark); display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                                                    🔄 Bộ ảnh 360° mặc định của xe
                                                    <a href="/admin/anh-360" target="_blank"
                                                        style="font-size: 11px; font-weight: 600; color: var(--primary); text-decoration: none; background: #eef2ff; padding: 2px 8px; border-radius: 20px;">+
                                                        Quản lý</a>
                                                </label>
                                                <p
                                                    style="margin: 0 0 16px 0; font-size: 11px; color: var(--text-muted); font-weight: normal;">
                                                    Bộ ảnh này sẽ dùng làm trình xoay 360 độ mặc định cho xe khi khách
                                                    hàng chưa chọn màu sắc cụ thể.</p>

                                                <div class="color-360-picker-container"
                                                    style="display: flex; align-items: center; gap: 10px; max-width: 500px;">
                                                    <input type="hidden" name="anh_360" class="color-360-input"
                                                        value="">
                                                    <div class="color-360-display-wrapper"
                                                        style="flex: 1; display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 12px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 13px; overflow: hidden; position: relative;">
                                                        <span class="color-360-name-display"
                                                            style="flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; color: var(--primary);">
                                                            -- Chưa liên kết --
                                                        </span>
                                                        <img class="color-360-thumb-preview" src=""
                                                            style="width: 44px; height: 30px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color); display: none;">
                                                        <button type="button" class="btn-clear-360"
                                                            style="background: none; border: none; color: #ef4444; font-size: 16px; font-weight: 700; cursor: pointer; padding: 0 6px; display: none;"
                                                            title="Xóa liên kết">✕</button>
                                                    </div>
                                                    <button type="button" class="btn-choose-360 btn secondary"
                                                        style="min-height: 38px; padding: 0 16px; font-size: 13px; font-weight: 700; margin: 0; cursor: pointer; flex-shrink: 0;">Chọn
                                                        bộ ảnh</button>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="spec-section-group">
                                            <div class="spec-section-group-title">
                                                🔧 Thông số kỹ thuật
                                                <small
                                                    style="font-weight:normal; font-size:12px; color:var(--text-muted);">Mỗi
                                                    ô là một nhóm. Mỗi dòng: <b>Tên thông số: Giá trị</b> (có nhãn) hoặc
                                                    <b>Tên thông số</b> (bullet điểm)</small>
                                            </div>
                                            <% (SPEC_SECTIONS || []).forEach((section)=> { %>
                                                <label class="spec-section-field">
                                                    <span class="spec-section-label-text">
                                                        <%= section.name %>
                                                    </span>
                                                    <textarea name="<%= section.key %>" rows="3"
                                                        placeholder="Nhập các thông số cho nhóm &quot;<%= section.name %>&quot;..."></textarea>
                                                </label>
                                                <% }) %>
                                                    <label class="spec-section-field">
                                                        <span class="spec-section-label-text">Thông số khác (nhóm tùy
                                                            chỉnh)</span>
                                                        <textarea name="spec_khac" rows="3"
                                                            placeholder="[Tên nhóm tùy chỉnh]&#10;Thông số 1: Giá trị&#10;Thông số 2"></textarea>
                                                    </label>
                                        </div>

                                        <!-- Trình soạn thảo Màu xe trực quan (Visual Color Editor) -->
                                        <div class="visual-colors-section"
                                            style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; background: #ffffff;">
                                            <div
                                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                                <div>
                                                    <strong style="font-size: 14px; color: var(--text-dark);">🎨 Bảng
                                                        màu xe trực quan</strong>
                                                    <small
                                                        style="display: block; color: var(--text-muted); font-size: 11px; margin-top: 4px; font-weight: normal;">Nhập
                                                        tên màu, chọn mã màu bằng bảng màu, chọn ảnh xe tương ứng và giá
                                                        bán thêm.</small>
                                                </div>
                                                <button type="button" class="btn secondary btn-add-color"
                                                    style="min-height: 32px; padding: 0 12px; font-size: 12px; cursor: pointer;">+
                                                    Thêm màu xe</button>
                                            </div>
                                            <div class="visual-colors-list"
                                                style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 12px;">
                                                <!-- Sẽ được thêm bằng Javascript -->
                                            </div>
                                            <textarea name="danh_sach_mau" style="display: none;"
                                                placeholder="Trắng Snowflake | #f7f7f2 | ford-everest.jpg | 0"></textarea>
                                        </div>



                                        <!-- Trình soạn thảo Đặc điểm sản phẩm trực quan (Visual Feature Editor) -->
                                        <div class="visual-features-section"
                                            style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; background: #ffffff;">
                                            <div
                                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                                <div>
                                                    <strong style="font-size: 14px; color: var(--text-dark);">✨ Đặc điểm
                                                        nổi bật (Key Selling Points)</strong>
                                                    <small
                                                        style="display: block; color: var(--text-muted); font-size: 11px; margin-top: 4px; font-weight: normal;">Dùng
                                                        để giới thiệu các tính năng, điểm nhấn nội ngoại thất nổi bật
                                                        của xe bằng hình ảnh và mô tả ngoài trang chi tiết.</small>
                                                </div>
                                                <button type="button" class="btn secondary btn-add-feature"
                                                    style="min-height: 32px; padding: 0 12px; font-size: 12px; cursor: pointer;">+
                                                    Thêm đặc điểm</button>
                                            </div>
                                            <div class="visual-features-list"
                                                style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 12px;">
                                                <!-- Sẽ được thêm bằng Javascript -->
                                            </div>
                                            <textarea name="dac_diem" style="display: none;"
                                                placeholder="ngoai_that | Kiểu dáng SUV | Thiết kế mạnh mẽ, hiện đại | carnival-exterior.jpg"></textarea>
                                        </div>

                                        <button type="submit">Thêm xe</button>
                                    </div>
                                </form>

                                <div class="admin-table-wrap">
                                    <h2>Sửa / xóa thông tin xe</h2>
                                    <div class="car-admin-list-head">
                                        <p>Chọn một xe trong danh sách để mở form chỉnh sửa hoặc xóa. Mỗi trang hiển thị
                                            6 xe.</p>
                                        <div class="car-admin-search-wrapper"
                                            style="flex: 1; max-width: 320px; margin: 0 20px;">
                                            <input type="text" id="car-search-input"
                                                placeholder="Tìm kiếm nhanh xe (tên, kiểu dáng)..."
                                                style="width: 100%; min-height: 36px; padding: 0 14px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 13px; outline: none; background: var(--bg-surface); transition: var(--transition-smooth);">
                                        </div>
                                        <div class="car-admin-pager">
                                            <button type="button" data-car-page-prev>Trước</button>
                                            <span data-car-page-status>1 / 1</span>
                                            <button type="button" data-car-page-next>Sau</button>
                                        </div>
                                    </div>
                                    <% if (cars && cars.length) { %>
                                        <div class="car-edit-list" data-car-edit-list>
                                            <% cars.forEach((car, index)=> { %>
                                                <article class="car-edit-item" data-car-item
                                                    data-car-index="<%= index %>">
                                                    <button type="button" class="car-edit-preview" data-car-toggle>
                                                        <img src="/images/<%= car.anh_dai_dien || 'no-car.jpg' %>"
                                                            alt="<%= car.ten_xe %>">
                                                        <strong>
                                                            <%= car.ten_xe %>
                                                                <%= car.phien_ban ? ' - ' + car.phien_ban : '' %>
                                                        </strong>
                                                        <span>
                                                            <%= displayVehicleType(car.ten_loai) %>
                                                        </span>
                                                        <small>Bấm để chỉnh sửa</small>
                                                    </button>

                                                    <form class="car-live-editor car-edit-form"
                                                        action="/admin/xe/<%= car.id %>/sua" method="post"
                                                        enctype="multipart/form-data"
                                                        data-preview-url="/xe/<%= car.duong_dan %>">
                                                        <input type="hidden" name="current_image"
                                                            value="<%= car.anh_dai_dien || '' %>">
                                                        <div class="car-editor-fields">

                                                            <!-- Nhóm 1: Thông tin cơ bản -->
                                                            <div class="form-group-card"
                                                                style="margin-bottom: 24px; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; background: #ffffff; box-shadow: var(--shadow-sm);">
                                                                <h3
                                                                    style="font-size: 15px; font-weight: 700; color: var(--text-dark); margin: 0 0 20px 0; border-bottom: 1.5px solid var(--primary-glow); padding-bottom: 10px; display: flex; align-items: center; gap: 8px;">
                                                                    📄 Thông tin cơ bản
                                                                </h3>
                                                                <div class="admin-form-grid">
                                                                    <label>
                                                                        Kiểu dáng xe
                                                                        <select name="dong_xe_id" required>
                                                                            <% uniqueModels.forEach((model)=> { %>
                                                                                <option value="<%= model.id %>"
                                                                                    <%=car.ten_loai===model.ten_loai
                                                                                    ? 'selected' : '' %>><%=
                                                                                        displayVehicleType(model.ten_loai)
                                                                                        %>
                                                                                </option>
                                                                                <% }) %>
                                                                        </select>
                                                                    </label>
                                                                    <label>
                                                                        Tên xe
                                                                        <input name="ten_xe" required
                                                                            value="<%= car.ten_xe || '' %>">
                                                                        <small
                                                                            style="color: var(--text-muted); font-weight: normal; margin-top: 4px; display: block; line-height: 1.4;">Nhập
                                                                            trùng tên xe với các bản khác để gom nhóm
                                                                            chúng.</small>
                                                                    </label>
                                                                    <label>
                                                                        Phiên bản
                                                                        <input name="phien_ban"
                                                                            value="<%= car.phien_ban || '' %>">
                                                                        <small
                                                                            style="color: var(--text-muted); font-weight: normal; margin-top: 4px; display: block; line-height: 1.4;">Ví
                                                                            dụ: Sport, Titanium, Platinum.</small>
                                                                    </label>
                                                                    <label>
                                                                        Năm sản xuất
                                                                        <input name="nam_san_xuat" type="number"
                                                                            value="<%= car.nam_san_xuat || '' %>">
                                                                    </label>
                                                                    <label>
                                                                        Giá bán
                                                                        <input name="gia_ban" type="number" required
                                                                            value="<%= Number(car.gia_ban || 0) %>">
                                                                    </label>
                                                                    <label>
                                                                        Giá niêm yết
                                                                        <input name="gia_niem_yet" type="number"
                                                                            value="<%= Number(car.gia_niem_yet || car.gia_ban || 0) %>">
                                                                    </label>
                                                                    <label>
                                                                        Số lượng tồn
                                                                        <input name="so_luong_ton" type="number"
                                                                            value="<%= car.so_luong_ton || 0 %>">
                                                                    </label>
                                                                    <label>
                                                                        Xuất xứ
