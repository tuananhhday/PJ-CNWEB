                <input type="text" class="feature-title-input" value="${tieu_de.replace(/"/g, '&quot;')}" placeholder="Ví dụ: Động cơ Ecoboost 2.0L mạnh mẽ" style="min-height: 34px; padding: 0 10px; font-size: 13px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-sm); width: 100%;">
