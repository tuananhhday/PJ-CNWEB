            // Sync visual inputs to textarea
            function syncColors(container) {
                const list = container.querySelector('.visual-colors-list');
                const textarea = container.querySelector('textarea[name="danh_sach_mau"]');
                if (!list || !textarea) return;

                const rows = Array.from(list.querySelectorAll('.visual-color-row'));
                const lines = rows.map((row) => {
                    const ten = row.querySelector('.color-name-input').value.trim();
                    const ma = row.querySelector('.color-hex-input').value.trim();
                    const anh = row.querySelector('.color-image-value-input').value.trim();
                    const gia = row.querySelector('.color-price-input').value.trim() || '0';
                    const input360 = row.querySelector('.color-360-input') || row.querySelector('.color-360-select');
                    const anh_360 = input360 ? input360.value.trim() : '';

                    if (!ten) return '';
                    return `${ten} | ${ma || '#ffffff'} | ${anh} | ${gia} | ${anh_360}`;
                }).filter(Boolean);

                textarea.value = lines.join('\n');
                // Trigger live preview update
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
            }

            function syncFeatures(container) {
                const list = container.querySelector('.visual-features-list');
                const textarea = container.querySelector('textarea[name="dac_diem"]');
                if (!list || !textarea) return;

                const cards = Array.from(list.querySelectorAll('.visual-feature-card'));
                const lines = cards.map((card) => {
                    const nhom = card.querySelector('.feature-group-select').value.trim();
                    const tieu_de = card.querySelector('.feature-title-input').value.trim();
                    const mo_ta = card.querySelector('.feature-desc-textarea').value.trim();
                    const anh = card.querySelector('.feature-image-select').value.trim();

                    if (!tieu_de) return '';
                    return `${nhom} | ${tieu_de} | ${mo_ta} | ${anh}`;
                }).filter(Boolean);

                textarea.value = lines.join('\n');
                // Trigger live preview update
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
            }

            function parseTextareaColors(text) {
                return text.split('\n').map((line) => {
                    const parts = line.split('|').map(p => p.trim());
                    if (parts.length < 1 || !parts[0]) return null;
                    return {
                        ten: parts[0] || '',
                        ma: parts[1] || '#ffffff',
                        anh: parts[2] || '',
                        gia: parts[3] || '0',
                        anh_360: parts[4] || ''
                    };
                }).filter(Boolean);
            }

            function parseTextareaFeatures(text) {
                return text.split('\n').map((line) => {
                    const parts = line.split('|').map(p => p.trim());
                    if (parts.length < 2 || !parts[1]) return null;
                    return {
                        nhom: parts[0] || 'noi_bat',
                        tieu_de: parts[1] || '',
                        mo_ta: parts[2] || '',
                        anh: parts[3] || ''
                    };
                }).filter(Boolean);
            }

            // Main Visual Editor Init
            function initVisualEditors() {
                // 1. Process Color Sections
                document.querySelectorAll('.visual-colors-section').forEach((container) => {
                    const list = container.querySelector('.visual-colors-list');
                    const textarea = container.querySelector('textarea[name="danh_sach_mau"]');
                    const btnAdd = container.querySelector('.btn-add-color');
                    if (!list || !textarea) return;

                    // Populate existing colors
                    const existingText = textarea.value.trim();
                    if (existingText) {
                        const colors = parseTextareaColors(existingText);
                        colors.forEach((color) => {
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = createColorRowHTML(color.ten, color.ma, color.anh, color.gia, color.anh_360);
                            const row = tempDiv.firstElementChild;
                            list.appendChild(row);
                        });
                    }

                    // Add handler
                    btnAdd?.addEventListener('click', (e) => {
                        e.preventDefault();
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = createColorRowHTML('', '#ffffff', '', '0', '');
                        const row = tempDiv.firstElementChild;
                        list.appendChild(row);
                        syncColors(container);
                        row.querySelector('.color-name-input').focus();
                    });

                    // Event listeners delegation for sync & image previews
                    list.addEventListener('input', (e) => {
                        const target = e.target;
                        if (target.classList.contains('color-name-input') || target.classList.contains('color-price-input') || target.classList.contains('color-360-input')) {
                            syncColors(container);
                        }
                        if (target.classList.contains('color-hex-input')) {
                            const picker = target.parentElement.querySelector('.color-picker-input');
                            if (picker && target.value.startsWith('#') && target.value.length === 7) {
                                picker.value = target.value;
                            }
                            syncColors(container);
                        }
                        if (target.classList.contains('color-picker-input')) {
                            const hexInput = target.parentElement.querySelector('.color-hex-input');
                            if (hexInput) hexInput.value = target.value;
                            syncColors(container);
                        }
                    });

                    list.addEventListener('change', async (e) => {
                        const target = e.target;
                        if (target.classList.contains('color-picker-input') || target.classList.contains('color-360-select')) {
                            syncColors(container);
                        }
                        if (target.classList.contains('color-image-file-picker')) {
                            const files = target.files;
                            if (!files || !files.length) return;

                            const row = target.closest('.visual-color-row');
                            const imgPreview = row.querySelector('.color-image-preview');
                            const valInput = row.querySelector('.color-image-value-input');
                            const nameDisplay = row.querySelector('.color-image-name-display');
                            const spinner = row.querySelector('.color-image-upload-spinner');

                            if (spinner) spinner.style.display = 'flex';
                            if (nameDisplay) nameDisplay.textContent = 'Đang tải lên...';

                            try {
                                const fd = new FormData();
                                fd.append('files', files[0]);

                                const res = await fetch('/admin/api/upload-images', { method: 'POST', body: fd });
                                const json = await res.json();

                                if (json.files && json.files.length) {
                                    const uploadedFile = json.files[0];
                                    if (valInput) valInput.value = uploadedFile;
                                    if (nameDisplay) {
                                        nameDisplay.textContent = uploadedFile;
                                        nameDisplay.title = uploadedFile;
                                    }
                                    if (imgPreview) {
                                        imgPreview.src = `/images/${uploadedFile}`;
                                    }
                                    syncColors(container);
                                } else {
                                    if (nameDisplay) nameDisplay.textContent = valInput.value || 'Chọn ảnh từ máy...';
                                    alert('Không thể tải ảnh lên.');
                                }
                            } catch (err) {
                                console.error('Lỗi tải ảnh màu xe:', err);
                                if (nameDisplay) nameDisplay.textContent = valInput.value || 'Chọn ảnh từ máy...';
                                alert('Đã có lỗi xảy ra khi tải ảnh lên.');
                            } finally {
                                if (spinner) spinner.style.display = 'none';
                                target.value = '';
                            }
                        }
                    });

                    list.addEventListener('click', (e) => {
                        const btnDelete = e.target.closest('.btn-delete-color');
                        if (btnDelete) {
                            e.preventDefault();
                            const row = btnDelete.closest('.visual-color-row');
                            if (row) {
                                row.remove();
                                syncColors(container);
                            }
                            return;
                        }

                        const btnUploadTrigger = e.target.closest('.btn-trigger-color-upload');
                        if (btnUploadTrigger) {
                            e.preventDefault();
                            const row = btnUploadTrigger.closest('.visual-color-row');
                            const filePicker = row.querySelector('.color-image-file-picker');
                            if (filePicker) filePicker.click();
                            return;
                        }


                        const btnGenTrigger = e.target.closest('.btn-generate-360-trigger');
                        if (btnGenTrigger) {
                            e.preventDefault();
                            const row = btnGenTrigger.closest('.visual-color-row');
                            const panel = row.querySelector('.gen-360-panel');
                            if (panel) {
                                panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex';
                            }
                            return;
                        }

                        const btnCancelGen = e.target.closest('.btn-cancel-gen-360');
                        if (btnCancelGen) {
                            e.preventDefault();
                            const row = btnCancelGen.closest('.visual-color-row');
                            const panel = row.querySelector('.gen-360-panel');
                            if (panel) {
                                panel.style.display = 'none';
                            }
                            return;
                        }

                        const btnExecuteGen = e.target.closest('.btn-execute-gen-360');
                        if (btnExecuteGen) {
                            e.preventDefault();
                            const row = btnExecuteGen.closest('.visual-color-row');
                            const panel = row.querySelector('.gen-360-panel');
                            const input = row.querySelector('.color-360-input');
                            if (panel && input) {
                                const prefix = panel.querySelector('.gen-360-prefix').value.trim();
                                const count = parseInt(panel.querySelector('.gen-360-count').value || 15);
                                const ext = panel.querySelector('.gen-360-ext').value;
                                const pad = panel.querySelector('.gen-360-pad').value;

                                if (!prefix) {
                                    alert('Vui lòng nhập tiền tố tên ảnh.');
                                    return;
                                }

                                const files = [];
                                for (let i = 1; i <= count; i++) {
                                    let numStr = String(i);
                                    if (pad === 'pad2' && i < 10) {
                                        numStr = '0' + numStr;
                                    }
                                    files.push(prefix + numStr + ext);
                                }
                                input.value = files.join(', ');
                                syncColors(container);
                                panel.style.display = 'none';
                            }
                            return;
                        }
                    });
                });

                // 2. Process Feature Sections
                document.querySelectorAll('.visual-features-section').forEach((container) => {
                    const list = container.querySelector('.visual-features-list');
                    const textarea = container.querySelector('textarea[name="dac_diem"]');
                    const btnAdd = container.querySelector('.btn-add-feature');
                    if (!list || !textarea) return;

                    // Populate existing features
                    const existingText = textarea.value.trim();
                    if (existingText) {
                        const features = parseTextareaFeatures(existingText);
                        features.forEach((feat) => {
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = createFeatureCardHTML(feat.nhom, feat.tieu_de, feat.mo_ta, feat.anh);
                            const card = tempDiv.firstElementChild;
                            list.appendChild(card);
                        });
                    }

                    // Add handler
                    btnAdd?.addEventListener('click', (e) => {
                        e.preventDefault();
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = createFeatureCardHTML('noi_bat', '', '', '');
                        const card = tempDiv.firstElementChild;
                        list.appendChild(card);
                        syncFeatures(container);
                        card.querySelector('.feature-title-input').focus();
                    });

                    // Event delegation
                    list.addEventListener('input', (e) => {
                        const target = e.target;
                        if (target.classList.contains('feature-title-input') || target.classList.contains('feature-desc-textarea')) {
                            syncFeatures(container);
                        }
                    });

                    list.addEventListener('change', (e) => {
                        const target = e.target;
                        if (target.classList.contains('feature-group-select')) {
                            syncFeatures(container);
                        }
                        if (target.classList.contains('feature-image-select')) {
                            const card = target.closest('.visual-feature-card');
                            const img = card.querySelector('.feature-image-preview');
                            if (img) {
                                img.src = target.value ? `/images/${target.value}` : '/images/no-car.jpg';
                            }
                            syncFeatures(container);
                        }
                    });

                    list.addEventListener('click', (e) => {
                        const btnDelete = e.target.closest('.btn-delete-feature');
                        if (btnDelete) {
                            e.preventDefault();
                            const card = btnDelete.closest('.visual-feature-card');
                            if (card) {
                                card.remove();
                                syncFeatures(container);
                            }
                        }
                    });
                });


            }

            // Run initializations
            initVisualEditors();

            // --- Global 360 Picker Modal Management ---
            let activePickerRow = null;
            let activePickerContainer = null;

            const modalPicker = document.getElementById('modal-picker-360');
            const modalPickerList = document.getElementById('modal-picker-list');
            const modalPickerSearch = document.getElementById('modal-picker-search');
            const modalPickerClose = document.getElementById('modal-picker-close');
            const modalPickerCancel = document.getElementById('modal-picker-cancel');

            function open360Picker(row, container) {
                activePickerRow = row;
                activePickerContainer = container;
                modalPickerSearch.value = '';
                renderPickerList('');
                modalPicker.style.display = 'flex';
            }

            function clear360Selection(row, container) {
                const input = row.querySelector('.color-360-input');
                const label = row.querySelector('.color-360-name-display');
                const thumb = row.querySelector('.color-360-thumb-preview');
                const btnClear = row.querySelector('.btn-clear-360');

                if (input) input.value = '';
                if (label) label.textContent = '-- Chưa liên kết --';
                if (thumb) {
                    thumb.src = '';
                    thumb.style.display = 'none';
                }
                if (btnClear) btnClear.style.display = 'none';

                if (container) syncColors(container);
            }

            function select360Set(set) {
                if (!activePickerRow) return;

                const input = activePickerRow.querySelector('.color-360-input');
                const label = activePickerRow.querySelector('.color-360-name-display');
                const thumb = activePickerRow.querySelector('.color-360-thumb-preview');
                const btnClear = activePickerRow.querySelector('.btn-clear-360');

                if (input) input.value = set.id;
                if (label) label.textContent = set.ten_bo_anh;

                if (thumb) {
                    if (set.danh_sach_anh) {
                        const firstImg = set.danh_sach_anh.split(',')[0].trim();
                        thumb.src = firstImg ? `/images/${firstImg}` : '';
                        thumb.style.display = firstImg ? 'block' : 'none';
                    } else {
                        thumb.src = '';
                        thumb.style.display = 'none';
                    }
                }
                if (btnClear) btnClear.style.display = 'block';

                if (activePickerContainer) syncColors(activePickerContainer);
                close360Picker();
            }

            function close360Picker() {
                modalPicker.style.display = 'none';
                activePickerRow = null;
                activePickerContainer = null;
            }

            if (modalPickerClose) modalPickerClose.addEventListener('click', close360Picker);
            if (modalPickerCancel) modalPickerCancel.addEventListener('click', close360Picker);

            if (modalPicker) {
                modalPicker.addEventListener('click', (e) => {
                    if (e.target === modalPicker) {
                        close360Picker();
                    }
                });
            }

            function renderPickerList(query = '') {
                if (!modalPickerList) return;
                modalPickerList.innerHTML = '';

                const filtered = (allBo360Sets || []).filter((set) => {
                    return !query || (set.ten_bo_anh || '').toLowerCase().includes(query.toLowerCase());
                });

                if (!filtered.length) {
                    modalPickerList.innerHTML = `
              <div style="text-align: center; padding: 40px 20px; color: var(--text-muted); font-size: 13px; font-style: italic;">
                  Không tìm thấy bộ ảnh nào phù hợp.
              </div>
          `;
                    return;
                }

                filtered.forEach((set) => {
                    const files = (set.danh_sach_anh || '').split(',').map(f => f.trim()).filter(Boolean);
                    const previewImg = files[0] ? `/images/${files[0]}` : '/images/no-car.jpg';

                    const item = document.createElement('div');
                    item.style.cssText = 'background: #ffffff; border: 1.5px solid var(--border-color); border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; gap: 14px; cursor: pointer; transition: all 0.2s;';

                    item.addEventListener('mouseenter', () => {
                        item.style.borderColor = 'var(--primary)';
                        item.style.boxShadow = '0 4px 12px rgba(99,102,241,0.08)';
                        item.style.transform = 'translateY(-1px)';
                    });
                    item.addEventListener('mouseleave', () => {
                        item.style.borderColor = 'var(--border-color)';
                        item.style.boxShadow = 'none';
                        item.style.transform = 'none';
                    });

                    item.innerHTML = `
              <img src="${previewImg}" style="width: 50px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color); flex-shrink: 0;" onerror="this.src='/images/no-car.jpg';">
              <div style="flex: 1; min-width: 0;">
                  <strong style="display: block; font-size: 13px; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${set.ten_bo_anh}</strong>
                  <span style="font-size: 11px; color: var(--text-muted);">${files.length} ảnh 360°</span>
              </div>
              <button type="button" class="btn secondary" style="margin: 0; min-height: 28px; padding: 0 10px; font-size: 11px; font-weight: 700; pointer-events: none;">Chọn</button>
          `;

                    item.addEventListener('click', () => select360Set(set));
                    modalPickerList.appendChild(item);
                });
            }

            if (modalPickerSearch) {
                modalPickerSearch.addEventListener('input', (e) => {
                    renderPickerList(e.target.value.trim());
                });
            }

            // Global click delegator for 360 Pickers
            document.addEventListener('click', (e) => {
                const btnChoose360 = e.target.closest('.btn-choose-360');
                if (btnChoose360) {
                    e.preventDefault();
                    // Find the picker wrapper
                    const pickerContainer = btnChoose360.closest('.color-360-picker-container');
                    if (pickerContainer) {
                        // The visual colors section is the container for color rows
                        const colorsSection = pickerContainer.closest('.visual-colors-section');
                        open360Picker(pickerContainer, colorsSection);
                    }
                    return;
                }

                const btnClear360 = e.target.closest('.btn-clear-360');
                if (btnClear360) {
                    e.preventDefault();
                    const pickerContainer = btnClear360.closest('.color-360-picker-container');
                    if (pickerContainer) {
                        const colorsSection = pickerContainer.closest('.visual-colors-section');
                        clear360Selection(pickerContainer, colorsSection);
                    }
                    return;
                }
            });

            renderCarPage(1);
        </script>
</body>

</html>
