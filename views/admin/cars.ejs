        <script>
            function handleFileSelectPreview(input) {
                const name = input.name;
                if (name !== 'anh_ngoai_that' && name !== 'anh_noi_that') return;

                const parent = input.closest('.admin-dynamic-upload-block') || input.parentElement;
                if (!parent) return;

                // Find or create preview wrapper
                let previewWrapper = parent.querySelector('.dynamic-image-preview-wrapper');
                if (!previewWrapper) {
                    previewWrapper = document.createElement('div');
                    previewWrapper.className = 'dynamic-image-preview-wrapper';
                    previewWrapper.style.cssText = 'display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; width: 100%;';
                    parent.appendChild(previewWrapper);
                }
                previewWrapper.innerHTML = ''; // Clear previous previews

                const files = input.files;
                if (!files || !files.length) return;

                const captionName = name === 'anh_ngoai_that' ? 'chu_thich_ngoai_that' : 'chu_thich_noi_that';

                Array.from(files).forEach((file) => {
                    const objectUrl = URL.createObjectURL(file);

                    const thumbCard = document.createElement('div');
                    thumbCard.className = 'thumb-card-item';
                    thumbCard.style.cssText = 'display: flex; flex-direction: column; gap: 6px; width: 140px; margin-top: 8px;';

                    thumbCard.innerHTML = `
                        <div class="thumb-container" style="width: 140px; height: 90px; margin: 0; position: relative; border-radius: var(--radius-sm); border: 1px solid var(--border-color); overflow: hidden; background: #ffffff;">
                            <img src="${objectUrl}" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <input name="${captionName}" type="text" placeholder="Thêm chú thích..." style="font-size: 11px; height: 28px; padding: 0 8px; width: 100%; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: var(--bg-surface-soft);" title="Chú thích ảnh">
                    `;
                    previewWrapper.appendChild(thumbCard);
                });
            }

            function addFileInput(containerId, inputName = 'danh_sach_anh', labelText = 'Ảnh khác') {
                const container = document.getElementById(containerId);

                // Create wrapper block for clean spacing
                const wrapper = document.createElement('div');
                wrapper.className = 'admin-dynamic-upload-block';
                wrapper.style.cssText = 'display: grid; gap: 8px; padding: 12px; background: #f8fafc; border: 1px dashed var(--border-color); border-radius: var(--radius-sm); margin-top: 8px; margin-bottom: 8px;';

                const fileLabel = document.createElement('label');
                fileLabel.style.margin = '0';
                fileLabel.innerHTML = `${labelText} <input name="${inputName}" type="file" accept="image/*" multiple onchange="handleFileSelectPreview(this)">`;
                wrapper.appendChild(fileLabel);

                container.appendChild(wrapper);
            }

            function formatPreviewPrice(value) {
                const number = Number(value || 0);
                return number ? number.toLocaleString('vi-VN') + ' VND' : 'Giá đang cập nhật';
            }

            function getField(form, name) {
                return form.querySelector(`[name="${name}"]`);
            }

            function getPreviewImage(form) {
                const fileInput = form.querySelector('[name="anh_dai_dien"]');
                if (fileInput && fileInput.files && fileInput.files[0]) {
                    return URL.createObjectURL(fileInput.files[0]);
                }

                const currentImage = form.querySelector('[name="current_image"]')?.value;
                if (currentImage) return `/images/${currentImage}`;

                const cardImage = form.closest('.car-edit-item')?.querySelector('.car-edit-preview img')?.getAttribute('src');
                return cardImage || '/images/no-car.jpg';
            }

            function parseLines(value, separator) {
                return String(value || '')
                    .split('\n')
                    .map((line) => line.trim())
                    .filter(Boolean)
                    .map((line) => line.split(separator).map((part) => part.trim()));
            }

            function setupPreviewDrag(preview) {
                const handle = preview.querySelector('.preview-drag-handle');
                const resetBtn = preview.querySelector('.preview-drag-btn-reset');
                if (!handle) return;

                let isDragging = false;
                let startX = 0;
                let startY = 0;
                let initialLeft = 0;
                let initialTop = 0;

                function resetPosition(e) {
                    if (e) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    preview.classList.remove('is-floating', 'is-dragging');
                    preview.style.position = '';
                    preview.style.left = '';
                    preview.style.top = '';
                    preview.style.width = '';
                    preview.style.transform = '';

                    localStorage.removeItem('preview-floating');
                    localStorage.removeItem('preview-left');
                    localStorage.removeItem('preview-top');
                }

                resetBtn.addEventListener('click', resetPosition);
                handle.addEventListener('dblclick', resetPosition);

                // Load saved position if exists
                if (localStorage.getItem('preview-floating') === 'true') {
                    preview.classList.add('is-floating');
                    preview.style.left = localStorage.getItem('preview-left') + 'px';
                    preview.style.top = localStorage.getItem('preview-top') + 'px';
                }

                function onStart(x, y) {
                    isDragging = true;
                    preview.classList.add('is-floating', 'is-dragging');

                    const rect = preview.getBoundingClientRect();
                    startX = x;
                    startY = y;
                    initialLeft = rect.left;
                    initialTop = rect.top;

                    preview.style.left = initialLeft + 'px';
                    preview.style.top = initialTop + 'px';
                    preview.style.margin = '0';

                    document.addEventListener('mousemove', onMove, { passive: false });
                    document.addEventListener('mouseup', onEnd);
                    document.addEventListener('touchmove', onTouchMove, { passive: false });
                    document.addEventListener('touchend', onEnd);
                }

                function onMove(e) {
                    if (!isDragging) return;
                    e.preventDefault();

                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;

                    let newLeft = initialLeft + dx;
                    let newTop = initialTop + dy;

                    const rect = preview.getBoundingClientRect();
                    const minX = 10;
                    const minY = 10;
                    const maxX = window.innerWidth - rect.width - 10;
                    const maxY = window.innerHeight - rect.height - 10;

                    newLeft = Math.max(minX, Math.min(newLeft, maxX));
                    newTop = Math.max(minY, Math.min(newTop, maxY));

                    preview.style.left = newLeft + 'px';
                    preview.style.top = newTop + 'px';
                }

                function onTouchMove(e) {
                    if (!isDragging) return;
                    if (e.touches.length === 0) return;
                    e.preventDefault();

                    const touch = e.touches[0];
                    const dx = touch.clientX - startX;
                    const dy = touch.clientY - startY;

                    let newLeft = initialLeft + dx;
                    let newTop = initialTop + dy;

                    const rect = preview.getBoundingClientRect();
                    const minX = 10;
                    const minY = 10;
                    const maxX = window.innerWidth - rect.width - 10;
                    const maxY = window.innerHeight - rect.height - 10;

                    newLeft = Math.max(minX, Math.min(newLeft, maxX));
                    newTop = Math.max(minY, Math.min(newTop, maxY));

                    preview.style.left = newLeft + 'px';
                    preview.style.top = newTop + 'px';
                }

                function onEnd() {
                    if (!isDragging) return;
                    isDragging = false;
                    preview.classList.remove('is-dragging');

                    const rect = preview.getBoundingClientRect();
                    localStorage.setItem('preview-floating', 'true');
                    localStorage.setItem('preview-left', rect.left);
                    localStorage.setItem('preview-top', rect.top);

                    document.removeEventListener('mousemove', onMove);
                    document.removeEventListener('mouseup', onEnd);
                    document.removeEventListener('touchmove', onTouchMove);
                    document.removeEventListener('touchend', onEnd);
                }

                handle.addEventListener('mousedown', (e) => {
                    if (e.target.closest('.preview-drag-btn-reset')) return;
                    e.preventDefault();
                    onStart(e.clientX, e.clientY);
                });

                handle.addEventListener('touchstart', (e) => {
                    if (e.target.closest('.preview-drag-btn-reset')) return;
                    if (e.touches.length === 0) return;
                    const touch = e.touches[0];
                    onStart(touch.clientX, touch.clientY);
                });
            }

            function createCarPreview(form) {
                const preview = document.createElement('aside');
                preview.className = 'car-live-preview';

                const previewUrl = form.dataset.previewUrl;
                const isRealDetailPage = previewUrl && previewUrl !== '/xe';

                preview.innerHTML = `
            <!-- Drag Handle Bar -->
            <div class="preview-drag-handle" title="Nhấp giữ để di chuyển bản xem trước tự do">
                <span class="preview-drag-title">Bản xem trước live</span>
                <button type="button" class="preview-drag-btn-reset" title="Đưa về vị trí mặc định bên phải">Neo lại</button>
            </div>

            <!-- Switcher Tabs -->
            <div class="live-preview-switcher-tabs">
                <button type="button" class="is-active" data-preview-tab="phone">Điện thoại</button>
                <button type="button" data-preview-tab="detail">Bản chi tiết</button>
                <button type="button" data-preview-tab="iframe">Trang thật</button>
            </div>
            
            <!-- Tab Content 1: Phone view -->
            <div class="live-preview-tab-content is-active" data-preview-content="phone">
                <div class="car-live-phone">
                    <img data-preview-img src="${getPreviewImage(form)}" alt="Ảnh xem trước">
                    <div>
                        <span data-preview-type>Thông tin xe</span>
                        <h3 data-preview-name>Xe mới</h3>
                        <p data-preview-slogan>Nhập mô tả ngắn để xem trước.</p>
                        <strong data-preview-price>Giá đang cập nhật</strong>
                        <dl>
                            <div><dt>Động cơ</dt><dd data-preview-engine>Đang cập nhật</dd></div>
                            <div><dt>Hộp số</dt><dd data-preview-gear>Đang cập nhật</dd></div>
                            <div><dt>Số chỗ</dt><dd data-preview-seats>Đang cập nhật</dd></div>
                        </dl>
                    </div>
                </div>
            </div>
            
            <!-- Tab Content 2: Detail showcase -->
            <div class="live-preview-tab-content" data-preview-content="detail">
                <div class="car-admin-detail-preview">
                    <div class="car-admin-detail-preview__top">
                        <span>Bản xem trước trang chi tiết</span>
                        <strong>Dữ liệu cập nhật khi bạn nhập</strong>
                    </div>
                    <div class="car-admin-detail-preview__hero">
                        <div>
                            <span data-preview-type-detail>Thông tin xe</span>
                            <h3 data-preview-name-detail>Xe mới</h3>
                            <p data-preview-slogan-detail>Nhập mô tả ngắn để xem trước.</p>
                            <strong data-preview-price-detail>Giá đang cập nhật</strong>
                            <div class="car-admin-detail-preview__actions">
                                <button type="button">Nhận báo giá</button>
                                <button type="button">Đặt lịch lái thử</button>
                            </div>
                        </div>
                        <img data-preview-img-detail src="${getPreviewImage(form)}" alt="Ảnh xem trước chi tiết xe">
                    </div>
                    <div class="car-admin-detail-preview__tabs">
                        <span>Tổng quan</span>
                        <span>Thư viện ảnh</span>
                        <span>Thông số kỹ thuật</span>
                        <span>Màu sắc</span>
                    </div>
                    <div class="car-admin-detail-preview__specs">
                        <div><small>Động cơ</small><b data-preview-engine-detail>Đang cập nhật</b></div>
                        <div><small>Hộp số</small><b data-preview-gear-detail>Đang cập nhật</b></div>
                        <div><small>Số chỗ</small><b data-preview-seats-detail>Đang cập nhật</b></div>
                    </div>
                    <div class="car-admin-detail-preview__section">
                        <h4>Thông số kỹ thuật</h4>
                        <dl data-live-specs></dl>
                    </div>
                    <div class="car-admin-detail-preview__section">
                        <h4>Màu xe</h4>
                        <div class="car-admin-detail-preview__colors" data-live-colors></div>
                    </div>
                    <div class="car-admin-detail-preview__section">
                        <h4>Đặc điểm sản phẩm</h4>
                        <div class="car-admin-detail-preview__features" data-live-features></div>
                    </div>
                </div>
            </div>
            
            <!-- Tab Content 3: Real Page Iframe -->
            <div class="live-preview-tab-content" data-preview-content="iframe">
                <div class="car-detail-page-preview">
                    ${isRealDetailPage ? `
                        <div class="car-detail-page-preview__bar">
                            <strong>Trang chi tiết xe thật</strong>
                            <a href="${previewUrl}" target="_blank" rel="noopener">Mở trang</a>
                        </div>
                        <iframe src="${previewUrl}" title="Xem trước trang chi tiết xe"></iframe>
                    ` : `
                        <div class="car-detail-page-preview__empty">
                            <strong>Trang chi tiết xe thật</strong>
                            <p>Xe mới cần được lưu trước, sau đó phần sửa xe sẽ hiển thị đúng trang chi tiết để bạn kiểm tra.</p>
                        </div>
                    `}
                </div>
            </div>
        `;

                // Add tab switcher event listener
                preview.querySelectorAll('[data-preview-tab]').forEach((tabBtn) => {
                    tabBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        const tabTarget = tabBtn.dataset.previewTab;
                        preview.querySelectorAll('[data-preview-tab]').forEach((btn) => btn.classList.toggle('is-active', btn === tabBtn));
                        preview.querySelectorAll('[data-preview-content]').forEach((content) => {
                            content.classList.toggle('is-active', content.dataset.previewContent === tabTarget);
                        });
                    });
                });

                // Initialize Drag and Drop
                setupPreviewDrag(preview);

                const title = form.querySelector('h2');
                if (title) title.insertAdjacentElement('afterend', preview);
                else form.insertAdjacentElement('afterbegin', preview);
                return preview;
            }

            function updateCarPreview(form) {
                const preview = form.querySelector('.car-live-preview');
                if (!preview) return;

                const name = getField(form, 'ten_xe')?.value || 'Xe mới';
                const version = getField(form, 'phien_ban')?.value || '';
                const fullName = version ? `${name} - ${version}` : name;

                const selectedModel = getField(form, 'dong_xe_id')?.selectedOptions?.[0]?.textContent || 'Thông tin xe';
                const modelCleaned = selectedModel.replace(/\s+/g, ' ').trim();
                const slogan = getField(form, 'mo_ta_ngan')?.value || 'Nhập mô tả ngắn để xem trước.';
                const price = getField(form, 'gia_ban')?.value;
                const engine = getField(form, 'dong_co')?.value || 'Đang cập nhật';
                const gear = getField(form, 'hop_so')?.value || 'Đang cập nhật';
                const seats = getField(form, 'so_cho_ngoi')?.value ? getField(form, 'so_cho_ngoi').value + ' chỗ' : 'Đang cập nhật';

                const previewImgSrc = getPreviewImage(form);

                // Update Phone View Tab
                const phoneName = preview.querySelector('[data-preview-name]');
                const phoneType = preview.querySelector('[data-preview-type]');
                const phoneSlogan = preview.querySelector('[data-preview-slogan]');
                const phonePrice = preview.querySelector('[data-preview-price]');
                const phoneEngine = preview.querySelector('[data-preview-engine]');
                const phoneGear = preview.querySelector('[data-preview-gear]');
                const phoneSeats = preview.querySelector('[data-preview-seats]');
                const phoneImg = preview.querySelector('[data-preview-img]');

                if (phoneName) phoneName.textContent = fullName;
                if (phoneType) phoneType.textContent = modelCleaned;
                if (phoneSlogan) phoneSlogan.textContent = slogan;
                if (phonePrice) phonePrice.textContent = formatPreviewPrice(price);
                if (phoneEngine) phoneEngine.textContent = engine;
                if (phoneGear) phoneGear.textContent = gear;
                if (phoneSeats) phoneSeats.textContent = seats;
                if (phoneImg) phoneImg.src = previewImgSrc;

                // Update Detail Showcase Tab
                const detailName = preview.querySelector('[data-preview-name-detail]');
                const detailType = preview.querySelector('[data-preview-type-detail]');
                const detailSlogan = preview.querySelector('[data-preview-slogan-detail]');
                const detailPrice = preview.querySelector('[data-preview-price-detail]');
                const detailEngine = preview.querySelector('[data-preview-engine-detail]');
                const detailGear = preview.querySelector('[data-preview-gear-detail]');
                const detailSeats = preview.querySelector('[data-preview-seats-detail]');
                const detailImg = preview.querySelector('[data-preview-img-detail]');

                if (detailName) detailName.textContent = fullName;
                if (detailType) detailType.textContent = modelCleaned;
                if (detailSlogan) detailSlogan.textContent = slogan;
                if (detailPrice) detailPrice.textContent = formatPreviewPrice(price);
                if (detailEngine) detailEngine.textContent = engine;
                if (detailGear) detailGear.textContent = gear;
                if (detailSeats) detailSeats.textContent = seats;
                if (detailImg) detailImg.src = previewImgSrc;

                // Update dynamic color list
                const colorsArea = getField(form, 'danh_sach_mau');
                if (colorsArea) {
                    const colors = parseLines(colorsArea.value, '|');
                    const colorsContainer = preview.querySelector('[data-live-colors]');
                    if (colorsContainer) {
                        colorsContainer.innerHTML = colors.length
                            ? colors.slice(0, 8).map(([label, color]) => `<span><i style="background:${color || '#e5e7eb'}"></i>${label || 'Màu xe'}</span>`).join('')
                            : '<span><i style="background:#e5e7eb"></i>Chưa nhập màu</span>';
                    }
                }

                // Update dynamic specifications list
                const specsArea = getField(form, 'thong_so');
                if (specsArea) {
                    const specs = parseLines(specsArea.value, ':');
                    const specsContainer = preview.querySelector('[data-live-specs]');
                    if (specsContainer) {
                        specsContainer.innerHTML = specs.length
                            ? specs.slice(0, 6).map(([label, val]) => `<div><dt>${label || 'Thông số'}</dt><dd>${val || 'Đang cập nhật'}</dd></div>`).join('')
                            : '<div><dt>Công suất</dt><dd>Đang cập nhật</dd></div><div><dt>Kích thước</dt><dd>Đang cập nhật</dd></div>';
                    }
                }

                // Update dynamic features list
                const featuresArea = getField(form, 'dac_diem');
                if (featuresArea) {
                    const features = parseLines(featuresArea.value, '|');
                    const featuresContainer = preview.querySelector('[data-live-features]');
                    if (featuresContainer) {
                        featuresContainer.innerHTML = features.length
                            ? features.slice(0, 4).map(([group, title, desc]) => `<article><small>${group || 'Đặc điểm'}</small><b>${title || 'Tiêu đề'}</b><p>${desc || 'Mô tả đang cập nhật'}</p></article>`).join('')
                            : '<article><small>Đặc điểm</small><b>Chưa nhập đặc điểm</b><p>Nội dung này sẽ hiển thị khi bạn nhập vào ô đặc điểm sản phẩm.</p></article>';
                    }
                }
            }

            document.querySelectorAll('.car-live-editor').forEach((form) => {
                createCarPreview(form);
                updateCarPreview(form);

                form.addEventListener('input', () => updateCarPreview(form));
                form.addEventListener('change', (event) => {
                    updateCarPreview(form);
                });
            });


        </script>
        <script>
            const carItems = Array.from(document.querySelectorAll('[data-car-item]'));
            const pageSize = 6;
            let currentCarPage = 1;
            let filteredCarItems = [...carItems];

            const searchInput = document.getElementById('car-search-input');

            function renderCarPage(page) {
                if (!carItems.length) return;

                const totalPages = Math.max(1, Math.ceil(filteredCarItems.length / pageSize));
                currentCarPage = Math.min(Math.max(page, 1), totalPages);
                const start = (currentCarPage - 1) * pageSize;
                const end = start + pageSize;

                // First hide all items completely using display: none (overrides flex/grid stylesheets)
                carItems.forEach((item) => {
                    item.style.display = 'none';
                });

                // Show only the visible ones from the filtered list
                filteredCarItems.forEach((item, index) => {
                    const visible = index >= start && index < end;
                    if (visible) {
                        item.style.display = ''; // Fallback to stylesheet's default display style (flex)
                    } else {
                        item.classList.remove('is-open');
                    }
                });

                const status = document.querySelector('[data-car-page-status]');
                const prev = document.querySelector('[data-car-page-prev]');
                const next = document.querySelector('[data-car-page-next]');

                if (status) status.textContent = `${currentCarPage} / ${totalPages}`;
                if (prev) prev.disabled = currentCarPage === 1;
                if (next) next.disabled = currentCarPage === totalPages;
            }

            // Handle live search input
            searchInput?.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();
                if (!query) {
                    filteredCarItems = [...carItems];
                } else {
                    filteredCarItems = carItems.filter((item) => {
                        const title = item.querySelector('strong')?.textContent.toLowerCase() || '';
                        const type = item.querySelector('span')?.textContent.toLowerCase() || '';
                        return title.includes(query) || type.includes(query);
                    });
                }
                renderCarPage(1);
            });

            document.querySelector('[data-car-page-prev]')?.addEventListener('click', () => renderCarPage(currentCarPage - 1));
            document.querySelector('[data-car-page-next]')?.addEventListener('click', () => renderCarPage(currentCarPage + 1));

            carItems.forEach((item) => {
                item.querySelector('[data-car-toggle]')?.addEventListener('click', () => {
                    const isOpening = !item.classList.contains('is-open');
                    carItems.forEach((otherItem) => otherItem.classList.remove('is-open'));
                    if (isOpening) {
                        item.classList.add('is-open');
                        item.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            renderCarPage(1);

