<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Quản lý tin tức' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/admin.css?v=admin-mobile-20260603">
    <!-- Quill Rich Text Editor CSS -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

    <style>
        /* Quill editor customization */
        .ql-toolbar.ql-snow {
            border: 1.5px solid #cbd5e1 !important;
            border-bottom: 0 !important;
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            background: #f8fafc;
        }
        .ql-container.ql-snow {
            border: 1.5px solid #cbd5e1 !important;
            border-bottom-left-radius: 6px;
            border-bottom-right-radius: 6px;
            background: #ffffff;
            font-family: inherit;
        }
        .ql-editor {
            min-height: 320px;
            font-size: 14px;
            line-height: 1.65;
            color: #1e293b;
        }

        /* Scoped styles for Modern Admin News CMS */
        .news-composer-card {
            background: #ffffff;
            border: 1px solid var(--border-color, #e2e8f0);
            border-radius: var(--radius-md, 10px);
            padding: 24px;
            box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
            margin-bottom: 32px;
            display: none; /* Controlled by JS toggle */
            animation: slideDown 0.3s ease-out;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .news-composer-header {
            font-size: 16px;
            font-weight: 800;
            color: var(--text-dark, #1e293b);
            margin: 0 0 20px 0;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--primary-glow, #eef2ff);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* WordPress-like side-by-side CMS editor layout */
        .blog-editor-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
            gap: 24px;
        }

        @media (max-width: 900px) {
            .blog-editor-layout {
                grid-template-columns: 1fr;
            }
        }

        .editor-main-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .editor-sidebar-panel {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 18px;
            align-self: start;
            width: 100%;
            box-sizing: border-box;
        }

        /* Form fields */
        .form-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-field label {
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .form-field input[type="text"],
        .form-field select,
        .form-field textarea {
            min-height: 42px;
            padding: 0 14px;
            border: 1.5px solid #cbd5e1;
            border-radius: 6px;
            font-size: 13px;
            background: #ffffff;
            color: #1e293b;
            outline: none;
            transition: all 0.2s ease;
            font-family: inherit;
        }

        .form-field input[type="text"]:focus,
        .form-field select:focus,
        .form-field textarea:focus {
            border-color: var(--primary, #6366f1);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        .form-field textarea {
            padding: 12px 14px;
            min-height: 180px;
            resize: vertical;
            line-height: 1.6;
        }

        /* File dropzone / upload button */
        .file-upload-zone {
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background: #ffffff;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .file-upload-zone:hover {
            border-color: var(--primary, #6366f1);
            background: #f8fafc;
        }

        .file-upload-zone input[type="file"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .upload-icon {
            font-size: 24px;
            margin-bottom: 8px;
            display: block;
        }

        .upload-text {
            font-size: 12px;
            color: #64748b;
            font-weight: 500;
        }

        .image-preview-container {
            margin-top: 10px;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            display: none;
            aspect-ratio: 16/9;
            background: #f1f5f9;
        }

        .image-preview-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Checkboxes section */
        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 12px 0 4px 0;
            border-top: 1px solid #e2e8f0;
        }

        .checkbox-group label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
        }

        .checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        /* List container & Cards Grid */
        .news-edit-list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
            margin-top: 20px;
        }

        @media (max-width: 1024px) {
            .news-edit-list {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 600px) {
            .news-edit-list {
                grid-template-columns: 1fr;
            }
        }

        .news-edit-item {
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            background: #ffffff;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .news-edit-preview {
            display: block;
            width: 100%;
            border: 0;
            padding: 0;
            text-align: left;
            background: transparent;
            cursor: pointer;
        }

        .news-edit-preview img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            background: var(--bg-surface-soft);
        }

        .news-preview-info {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .news-preview-info strong {
            display: block;
            font-family: var(--font-title);
            font-size: 15px;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 42px;
        }

        .news-admin-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 4px 0;
        }

        .news-admin-badges span {
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
        }

        .badge-status {
            text-transform: uppercase;
        }
        .badge-status.hien { background: #dcfce7; color: #166534; }
        .badge-status.nhap { background: #fef3c7; color: #92400e; }
        .badge-status.an { background: #fee2e2; color: #991b1b; }

        .badge-opt {
            background: #f1f5f9;
            color: #475569;
        }
        .badge-opt.ghim {
            background: #e0f2fe;
            color: #0369a1;
        }

        .news-preview-info span {
            display: block;
            font-size: 11px;
            color: var(--text-muted);
        }

        .news-preview-info small {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: var(--primary);
            padding: 8px 0 0 0;
            border-top: 1px dashed var(--border-color);
            margin-top: 8px;
            text-align: center;
        }

        /* Expanded Accordion state */
        .news-edit-item.is-open {
            grid-column: 1 / -1;
        }

        .news-edit-item.is-open .news-edit-preview {
            display: grid;
            grid-template-columns: 240px minmax(0, 1fr);
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        @media (max-width: 650px) {
            .news-edit-item.is-open .news-edit-preview {
                grid-template-columns: 1fr;
            }
        }

        .news-edit-item.is-open .news-edit-preview img {
            height: 135px;
            padding: 0;
            background: #ffffff;
        }

        .news-edit-item.is-open .news-preview-info {
            padding: 20px 24px;
        }

        .news-edit-item.is-open .news-preview-info strong {
            font-size: 18px;
            height: auto;
            -webkit-line-clamp: unset;
        }

        .news-edit-item.is-open .news-preview-info small {
            display: none;
        }

        .news-edit-item .news-edit-form,
        .news-edit-item > form:not(.news-edit-form) {
            display: none;
        }

        .news-edit-item.is-open .news-edit-form {
            display: block;
            padding: 24px;
        }

        .news-edit-item.is-open > form:not(.news-edit-form) {
            display: block;
            padding: 0 24px 24px;
        }

        .form-actions-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1.5px solid #e2e8f0;
        }

        /* Header control panel */
        .admin-controls-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
        }

        @media (max-width: 600px) {
            .admin-controls-row {
                flex-direction: column;
                align-items: stretch;
            }
        }

        .search-wrapper {
            position: relative;
            flex: 1;
            max-width: 320px;
        }

        .search-wrapper input {
            width: 100%;
            min-height: 38px;
            padding: 0 14px 0 36px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 13px;
            outline: none;
            background: var(--bg-surface);
            transition: var(--transition-smooth);
        }

        .search-wrapper input:focus {
            border-color: var(--primary);
            background: #ffffff;
            box-shadow: 0 0 0 3px var(--primary-glow);
        }

        .search-wrapper svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        /* Pager controls */
        .pager-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pager-wrapper button {
            min-height: 34px;
            padding: 0 12px;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--text-dark);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition-smooth);
        }

        .pager-wrapper button:hover:not(:disabled) {
            border-color: var(--primary);
            color: var(--primary);
        }

        .pager-wrapper button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            color: var(--text-muted);
        }

        .pager-status-text {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            padding: 0 4px;
        }

        .btn-add-toggle {
            min-height: 38px;
            padding: 0 16px;
            font-size: 13px;
            font-weight: 700;
            background: var(--primary);
            color: var(--text-light);
            border: 0;
            border-radius: var(--radius-sm);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition-smooth);
        }

        .btn-add-toggle:hover {
            background: var(--primary-dark);
            box-shadow: var(--shadow-glow);
            transform: translateY(-1px);
        }
    </style>
</head>

<body>
    <main class="admin-page">
        <aside class="admin-sidebar">
            <a class="admin-brand" href="/trang-chu">Showroom</a>
            <a href="/admin/dai-ly">Quản lý đại lý</a>
            <a class="is-active" href="/admin/tin-tuc">Quản lý tin tức</a>
            <a href="/admin/xe">Quản lý xe</a>
            <a href="/admin/anh-360">📸 Bộ ảnh 360°</a>
            <a href="/admin/yeu-cau">Báo giá / Lái thử</a>
            <a href="/admin/panel">Quản lý panel</a>
            <a href="/trang-chu">Xem trang chủ</a>
        </aside>

        <section class="admin-content">
            <div class="admin-heading">
                <div>
                    <p>Admin</p>
                    <h1>Quản lý tin tức</h1>
                </div>
                <div style="display: flex; gap: 12px;">
                    <a href="/tin-tuc" target="_blank" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 16px; font-size: 13px; font-weight: 700; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #ffffff; color: var(--text-dark);">
                        Mở trang tin tức
                    </a>
                    <button type="button" class="btn-add-toggle" id="btn-toggle-composer">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Viết bài mới
                    </button>
                </div>
            </div>

            <% if (success) { %>
                <div class="admin-alert success">
                    <%= success %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="admin-alert error">
                    <%= error %>
                </div>
            <% } %>

            <!-- Form Đăng Bài Mới (Collapsed by default) -->
            <div class="news-composer-card" id="composer-card">
                <div class="news-composer-header">
                    ✍️ Viết bài viết tin tức mới
                </div>
                <form action="/admin/tin-tuc/them" method="post" enctype="multipart/form-data">
                    <div class="blog-editor-layout">
                        <!-- Main Panel -->
                        <div class="editor-main-panel">
                            <div class="form-field">
                                <label>Tiêu đề bài viết <span style="color:red;">*</span></label>
                                <input name="tieu_de" required placeholder="Ví dụ: Khai trương showroom mới với nhiều ưu đãi lớn..." style="font-size: 15px; font-weight: 600;">
                            </div>
                            <div class="form-field">
                                <label>Đường dẫn tĩnh (Slug / URL)</label>
                                <input name="duong_dan" placeholder="khai-truong-showroom-moi-uu-dai-lon (tự động tạo nếu để trống)">
                            </div>
                            <div class="form-field">
                                <label>Nội dung bài viết <span style="color:red;">*</span></label>
                                <input type="hidden" name="noi_dung" id="composer-noi-dung">
                                <div id="composer-editor"></div>
                            </div>
                        </div>

                        <!-- Sidebar Settings -->
                        <div class="editor-sidebar-panel">
                            <div class="form-field">
                                <label>Ảnh đại diện bài viết</label>
                                <div class="file-upload-zone">
                                    <span class="upload-icon">📷</span>
                                    <span class="upload-text">Nhấp để chọn ảnh tải lên</span>
                                    <input name="anh_dai_dien" type="file" accept="image/*" class="composer-file-input">
                                </div>
                                <div class="image-preview-container composer-preview-box">
                                    <img src="" class="composer-preview-img">
                                </div>
                            </div>

                            <div class="form-field">
                                <label>Tác giả</label>
                                <input name="tac_gia" value="Showroom Double Anh" placeholder="Nhập tên tác giả">
                            </div>

                            <div class="form-field">
                                <label>Trạng thái bài viết</label>
                                <select name="trang_thai">
                                    <option value="hien">🟢 Đăng công khai</option>
                                    <option value="nhap">🟡 Lưu bản nháp</option>
                                    <option value="an">🔴 Ẩn bài viết</option>
                                </select>
                            </div>

                            <div class="checkbox-group">
                                <label>
                                    <input name="ghim" type="checkbox">
                                    <span>Ghim bài viết lên đầu</span>
                                </label>
                                <label>
                                    <input name="xem_nhieu" type="checkbox">
                                    <span>Hiển thị mục Xem nhiều</span>
                                </label>
                                <label>
                                    <input name="hien_sidebar" type="checkbox">
                                    <span>Hiển thị ở Sidebar tin tức</span>
                                </label>
                            </div>

                            <button type="submit" style="width: 100%; margin-top: 10px;">Đăng bài viết</button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Danh sách bài viết -->
            <div class="admin-table-wrap">
                <div class="admin-controls-row">
                    <h2>Danh sách bài viết đã tạo</h2>
                    <div class="search-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="news-search-input" placeholder="Tìm tên bài viết, tác giả...">
                    </div>
                    <div class="pager-wrapper">
                        <button type="button" id="news-page-prev">Trước</button>
                        <span class="pager-status-text" id="news-page-status">1 / 1</span>
                        <button type="button" id="news-page-next">Sau</button>
                    </div>
                </div>

                <% if (posts && posts.length) { %>
                    <div class="news-edit-list" id="news-list-container">
                        <% posts.forEach((post, index) => { %>
                            <article class="news-edit-item" data-news-item data-news-index="<%= index %>">
                                <button type="button" class="news-edit-preview" data-news-toggle>
                                    <img src="/images/<%= post.anh_dai_dien || 'no-car.jpg' %>" alt="<%= post.tieu_de %>" onerror="this.src='/images/no-car.jpg';">
                                    <div class="news-preview-info">
                                        <strong><%= post.tieu_de %></strong>
                                        <div class="news-admin-badges">
                                            <span class="badge-status <%= post.trang_thai %>">
                                                <%= post.trang_thai === 'hien' ? 'Công khai' : post.trang_thai === 'nhap' ? 'Bản nháp' : 'Đang ẩn' %>
                                            </span>
                                            <% if (Number(post.xem_nhieu)) { %>
                                                <span class="badge-opt">Xem nhiều</span>
                                            <% } %>
                                            <% if (Number(post.hien_sidebar)) { %>
                                                <span class="badge-opt">Sidebar</span>
                                            <% } %>
                                            <% if (Number(post.ghim)) { %>
                                                <span class="badge-opt ghim">Đã ghim</span>
                                            <% } %>
                                        </div>
                                        <span>Tác giả: <%= post.tac_gia || 'Showroom Double Anh' %> | Ngày tạo: <%= formatDateTime(post.ngay_tao) %></span>
                                        <small>Bấm để chỉnh sửa hoặc xóa</small>
                                    </div>
                                </button>

                                <!-- Form chỉnh sửa chi tiết (Accordion expand) -->
                                <form class="news-edit-form" action="/admin/tin-tuc/<%= post.id %>/sua" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="current_image" value="<%= post.anh_dai_dien || '' %>">
                                    
                                    <div class="blog-editor-layout">
                                        <!-- Main Panel -->
                                        <div class="editor-main-panel">
                                            <div class="form-field">
                                                <label>Tiêu đề bài viết <span style="color:red;">*</span></label>
                                                <input name="tieu_de" required value="<%= post.tieu_de || '' %>" style="font-size: 15px; font-weight: 600;">
                                            </div>
                                            <div class="form-field">
                                                <label>Đường dẫn tĩnh (Slug / URL)</label>
                                                <input name="duong_dan" value="<%= post.duong_dan || '' %>">
                                            </div>
                                            <div class="form-field">
                                                <label>Nội dung bài viết <span style="color:red;">*</span></label>
                                                <input type="hidden" name="noi_dung" id="edit-noi-dung-<%= post.id %>">
                                                <div id="edit-editor-<%= post.id %>" class="quill-edit-editor" data-post-id="<%= post.id %>"><%- post.noi_dung %></div>
                                            </div>
                                        </div>

                                        <!-- Sidebar Panel -->
                                        <div class="editor-sidebar-panel">
                                            <div class="form-field">
                                                <label>Đổi ảnh đại diện</label>
                                                <div class="file-upload-zone">
                                                    <span class="upload-icon">📷</span>
                                                    <span class="upload-text">Nhấp để đổi ảnh</span>
                                                    <input name="anh_dai_dien" type="file" accept="image/*" class="edit-file-input">
                                                </div>
                                                <div class="image-preview-container edit-preview-box" style="display: block;">
                                                    <img src="/images/<%= post.anh_dai_dien || 'no-car.jpg' %>" class="edit-preview-img" onerror="this.src='/images/no-car.jpg';">
                                                </div>
                                            </div>

                                            <div class="form-field">
                                                <label>Tác giả</label>
                                                <input name="tac_gia" value="<%= post.tac_gia || '' %>">
                                            </div>

                                            <div class="form-field">
                                                <label>Trạng thái</label>
                                                <select name="trang_thai">
                                                    <option value="hien" <%= post.trang_thai === 'hien' ? 'selected' : '' %>>🟢 Đăng công khai</option>
                                                    <option value="nhap" <%= post.trang_thai === 'nhap' ? 'selected' : '' %>>🟡 Lưu bản nháp</option>
                                                    <option value="an" <%= post.trang_thai === 'an' ? 'selected' : '' %>>🔴 Ẩn bài viết</option>
                                                </select>
                                            </div>

                                            <div class="checkbox-group">
                                                <label>
                                                    <input name="ghim" type="checkbox" <%= Number(post.ghim) ? 'checked' : '' %>>
                                                    <span>Ghim bài viết lên đầu</span>
                                                </label>
                                                <label>
                                                    <input name="xem_nhieu" type="checkbox" <%= Number(post.xem_nhieu) ? 'checked' : '' %>>
                                                    <span>Hiển thị mục Xem nhiều</span>
                                                </label>
                                                <label>
                                                    <input name="hien_sidebar" type="checkbox" <%= Number(post.hien_sidebar) ? 'checked' : '' %>>
                                                    <span>Hiển thị ở Sidebar tin tức</span>
                                                </label>
                                            </div>

                                            <div class="form-actions-bar">
                                                <button type="submit" class="btn primary">Lưu bài viết</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

                                <!-- Form Xóa bài viết độc lập -->
                                <form action="/admin/tin-tuc/<%= post.id %>/xoa" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                    <button class="danger-button" type="submit" style="width: fit-content; min-height: 38px; margin: 0 24px 24px;">Xóa bài viết</button>
                                </form>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="empty-state">Chưa có bài viết nào.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Quill Rich Text Editor JS -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        // Initialize Quill for New Post Composer
        const composerInput = document.getElementById('composer-noi-dung');
        const composerEditorContainer = document.getElementById('composer-editor');
        let composerQuill = null;
        if (composerEditorContainer) {
            composerQuill = new Quill('#composer-editor', {
                theme: 'snow',
                placeholder: 'Nhập nội dung bài viết tin tức đầy đủ tại đây...',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, 4, false] }],
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['link', 'image', 'video'],
                        ['clean']
                    ]
                }
            });

            // On submit form composer, sync content
            const composerForm = composerEditorContainer.closest('form');
            if (composerForm) {
                composerForm.addEventListener('submit', function(e) {
                    const html = composerQuill.root.innerHTML;
                    if (composerQuill.getText().trim() === '') {
                        alert('Vui lòng nhập nội dung bài viết.');
                        e.preventDefault();
                        return false;
                    }
                    composerInput.value = html;
                });
            }
        }

        // Initialize Quill for Edit Post Accordion loop
        document.querySelectorAll('.quill-edit-editor').forEach(editorEl => {
            const postId = editorEl.dataset.postId;
            const editInput = document.getElementById(`edit-noi-dung-${postId}`);
            if (editInput) {
                const editQuill = new Quill(editorEl, {
                    theme: 'snow',
                    placeholder: 'Nhập nội dung bài viết tin tức đầy đủ...',
                    modules: {
                        toolbar: [
                            [{ 'header': [1, 2, 3, 4, false] }],
                            [{ 'size': ['small', false, 'large', 'huge'] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            [{ 'align': [] }],
                            ['link', 'image', 'video'],
                            ['clean']
                        ]
                    }
                });

                // On submit form edit, sync content
                const editForm = editorEl.closest('form');
                if (editForm) {
                    editForm.addEventListener('submit', function(e) {
                        const html = editQuill.root.innerHTML;
                        if (editQuill.getText().trim() === '') {
                            alert('Vui lòng nhập nội dung bài viết khi sửa.');
                            e.preventDefault();
                            return false;
                        }
                        editInput.value = html;
                    });
                }
            }
        });

        // Toggle Đăng bài viết mới
        const btnToggleComposer = document.getElementById('btn-toggle-composer');
        const composerCard = document.getElementById('composer-card');

        if (btnToggleComposer && composerCard) {
            btnToggleComposer.addEventListener('click', () => {
                const isOpen = composerCard.style.display === 'block';
                composerCard.style.display = isOpen ? 'none' : 'block';
                
                if (!isOpen) {
                    composerCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    // Rotate or change toggle icon
                    btnToggleComposer.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        Đóng khung soạn
                    `;
                    btnToggleComposer.style.background = '#64748b';
                } else {
                    btnToggleComposer.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Viết bài mới
                    `;
                    btnToggleComposer.style.background = 'var(--primary)';
                }
            });
        }

        // Live image upload preview helper
        function setupLiveUploadPreview(fileInputSelector, previewBoxSelector, previewImgSelector) {
            document.querySelectorAll(fileInputSelector).forEach(input => {
                input.addEventListener('change', function() {
                    const file = this.files[0];
                    const card = this.closest('form') || this.closest('.news-composer-card');
                    const previewBox = card.querySelector(previewBoxSelector);
                    const previewImg = card.querySelector(previewImgSelector);

                    if (file && previewBox && previewImg) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            previewImg.src = e.target.result;
                            previewBox.style.display = 'block';
                        }
                        reader.readAsDataURL(file);
                    }
                });
            });
        }

        setupLiveUploadPreview('.composer-file-input', '.composer-preview-box', '.composer-preview-img');
        setupLiveUploadPreview('.edit-file-input', '.edit-preview-box', '.edit-preview-img');

        // Accordion toggle logic for news items
        const newsItems = Array.from(document.querySelectorAll('[data-news-item]'));
        newsItems.forEach(item => {
            const toggleBtn = item.querySelector('[data-news-toggle]');
            toggleBtn?.addEventListener('click', () => {
                const isAlreadyOpen = item.classList.contains('is-open');
                
                // Close all others
                newsItems.forEach(otherItem => otherItem.classList.remove('is-open'));
                
                if (!isAlreadyOpen) {
                    item.classList.add('is-open');
                    setTimeout(() => {
                        item.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 50);
                }
            });
        });

        // Search & Pagination client-side filter logic
        const searchInput = document.getElementById('news-search-input');
        const prevBtn = document.getElementById('news-page-prev');
        const nextBtn = document.getElementById('news-page-next');
        const statusText = document.getElementById('news-page-status');

        let currentPage = 1;
        const itemsPerPage = 6;
        let filteredItems = [...newsItems];

        function renderPage(page) {
            currentPage = page;
            const totalItems = filteredItems.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;

            newsItems.forEach(item => {
                // If item is in current page viewport and matches search, show it. Otherwise, hide.
                const matchIndex = filteredItems.indexOf(item);
                if (matchIndex >= startIndex && matchIndex < endIndex) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                    item.classList.remove('is-open'); // Collapsed hidden items
                }
            });

            // Update status text
            statusText.textContent = `${currentPage} / ${totalPages}`;
            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        function filterNews() {
            const query = searchInput.value.toLowerCase().trim();
            if (!query) {
                filteredItems = [...newsItems];
            } else {
                filteredItems = newsItems.filter(item => {
                    const title = item.querySelector('strong')?.textContent.toLowerCase() || '';
                    const author = item.querySelector('.news-preview-info span')?.textContent.toLowerCase() || '';
                    return title.includes(query) || author.includes(query);
                });
            }
            renderPage(1);
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterNews);
        }
        if (prevBtn) {
            prevBtn.addEventListener('click', () => renderPage(currentPage - 1));
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', () => renderPage(currentPage + 1));
        }

        // Run initial page render
        renderPage(1);
    </script>
</body>

</html>
