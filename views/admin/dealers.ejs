<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Quản lý đại lý' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body>
<main class="admin-page">
    <aside class="admin-sidebar">
        <a class="admin-brand" href="/trang-chu">Showroom</a>
        <a href="/admin/xe">Quản lý xe</a>
        <a href="/admin/panel">Quản lý panel</a>
        <a class="is-active" href="/admin/dai-ly">Quản lý đại lý</a>
        <a href="/admin/yeu-cau">Báo giá / Lái thử</a>
        <a href="/admin/tin-tuc">Quản lý tin tức</a>
        <a href="/trang-chu">Xem trang chủ</a>
    </aside>

    <section class="admin-content">
        <div class="admin-heading">
            <div>
                <p>Admin</p>
                <h1>Quản lý đại lý</h1>
            </div>
            <a href="/lien-he">Mở trang đại lý</a>
        </div>

        <% if (success) { %>
            <div class="admin-alert success"><%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="admin-alert error"><%= error %></div>
        <% } %>

        <form class="admin-form" action="/admin/dai-ly/them" method="post">
            <h2>Thêm đại lý bán xe</h2>
            <div class="admin-form-grid">
                <label>
                    Tên đại lý*
                    <input name="ten_dai_ly" required placeholder="Showroom Double Anh Hà Nội">
                </label>
                <label>
                    Đường dẫn
                    <input name="duong_dan" placeholder="showroom-double-anh-ha-noi">
                    <small>Bỏ trống để hệ thống tự tạo.</small>
                </label>
                <label>
                    Thành phố*
                    <input name="thanh_pho" required placeholder="Hà Nội">
                </label>
                <label>
                    Vùng miền
                    <input name="vung_mien" placeholder="Miền Bắc">
                </label>
                <label>
                    Khu vực
                    <input name="khu_vuc" placeholder="Hà Nội">
                </label>
                <label>
                    Loại đại lý
                    <input name="loai_dai_ly" placeholder="Đại lý bán xe">
                </label>
                <label>
                    Số điện thoại
                    <input name="so_dien_thoai" placeholder="0900 000 000">
                </label>
                <label>
                    Email
                    <input name="email" type="email" placeholder="sales@doubleanh.vn">
                </label>
                <label>
                    Website
                    <input name="website" placeholder="https://doubleanh.vn">
                </label>
                <label>
                    Địa chỉ showroom*
                    <input name="dia_chi" required placeholder="12 Trần Duy Hưng, Cầu Giấy">
                </label>
                <label>
                    Link Google Maps
                    <input name="google_map_url" placeholder="https://maps.google.com/...">
                </label>
                <label>
                    Link nhúng bản đồ
                    <input name="map_embed_url" placeholder="https://www.google.com/maps?...&output=embed">
                </label>
                <label>
                    Giờ làm việc
                    <input name="gio_lam_viec" placeholder="08:00 - 19:00, Thứ 2 đến Chủ nhật">
                </label>
                <label>
                    Thứ tự
                    <input name="thu_tu" type="number" value="0">
                </label>
                <label>
                    Trạng thái
                    <select name="trang_thai">
                        <option value="hien">Hiện</option>
                        <option value="an">Ẩn</option>
                    </select>
                </label>
            </div>
            <label>
                Mô tả đại lý
                <textarea name="mo_ta" rows="4" placeholder="Không gian trưng bày, tư vấn trả góp, đăng ký lái thử..."></textarea>
            </label>
            <button type="submit">Thêm đại lý</button>
        </form>

        <div class="admin-table-wrap">
            <h2>Sửa / xóa đại lý</h2>
            <% if (dealers && dealers.length) { %>
                <div class="dealer-admin-list">
                    <% dealers.forEach((dealer) => { %>
                        <article class="dealer-admin-item">
                            <div class="dealer-admin-summary">
                                <strong><%= dealer.ten_dai_ly %></strong>
                                <span><%= dealer.khu_vuc || dealer.thanh_pho %></span>
                                <small><%= dealer.trang_thai === 'hien' ? 'Đang hiển thị' : 'Đang ẩn' %></small>
                                <a href="/lien-he#dealer-<%= dealer.id %>">Xem trên web</a>
                            </div>

                            <form action="/admin/dai-ly/<%= dealer.id %>/sua" method="post">
                                <div class="admin-form-grid">
                                    <label>Tên đại lý*<input name="ten_dai_ly" required value="<%= dealer.ten_dai_ly || '' %>"></label>
                                    <label>Đường dẫn<input name="duong_dan" value="<%= dealer.duong_dan || '' %>"></label>
                                    <label>Thành phố*<input name="thanh_pho" required value="<%= dealer.thanh_pho || '' %>"></label>
                                    <label>Vùng miền<input name="vung_mien" value="<%= dealer.vung_mien || '' %>"></label>
                                    <label>Khu vực<input name="khu_vuc" value="<%= dealer.khu_vuc || '' %>"></label>
                                    <label>Loại đại lý<input name="loai_dai_ly" value="<%= dealer.loai_dai_ly || '' %>"></label>
                                    <label>Số điện thoại<input name="so_dien_thoai" value="<%= dealer.so_dien_thoai || '' %>"></label>
                                    <label>Email<input name="email" type="email" value="<%= dealer.email || '' %>"></label>
                                    <label>Website<input name="website" value="<%= dealer.website || '' %>"></label>
                                    <label>Địa chỉ showroom*<input name="dia_chi" required value="<%= dealer.dia_chi || '' %>"></label>
                                    <label>Link Google Maps<input name="google_map_url" value="<%= dealer.google_map_url || '' %>"></label>
                                    <label>Link nhúng bản đồ<input name="map_embed_url" value="<%= dealer.map_embed_url || '' %>"></label>
                                    <label>Giờ làm việc<input name="gio_lam_viec" value="<%= dealer.gio_lam_viec || '' %>"></label>
                                    <label>Thứ tự<input name="thu_tu" type="number" value="<%= dealer.thu_tu || 0 %>"></label>
                                    <label>
                                        Trạng thái
                                        <select name="trang_thai">
                                            <option value="hien" <%= dealer.trang_thai === 'hien' ? 'selected' : '' %>>Hiện</option>
                                            <option value="an" <%= dealer.trang_thai === 'an' ? 'selected' : '' %>>Ẩn</option>
                                        </select>
                                    </label>
                                </div>
                                <label>Mô tả<textarea name="mo_ta" rows="4"><%= dealer.mo_ta || '' %></textarea></label>
                                <div class="panel-admin-actions">
                                    <button type="submit">Lưu đại lý</button>
                                </div>
                            </form>

                            <form action="/admin/dai-ly/<%= dealer.id %>/xoa" method="post">
                                <button class="danger-button" type="submit">Xóa</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-state">Chưa có đại lý nào.</p>
            <% } %>
        </div>
    </section>
</main>
</body>
</html>
