<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body>
<div class="admin-layout">
    <%- include('partials/nav') %>

    <main class="admin-main">
        <header class="admin-top">
            <div>
                <p>Xin chào, <%= currentUser ? currentUser.ho_ten : 'Quản lý' %></p>
                <h1>Quản trị showroom</h1>
            </div>
        </header>

        <section class="stat-grid">
            <article><span>Xe</span><strong><%= stats.cars %></strong></article>
            <article><span>Yêu cầu báo giá</span><strong><%= stats.quotes %></strong></article>
            <article><span>Lịch lái thử</span><strong><%= stats.testDrives %></strong></article>
            <article><span>Showroom</span><strong><%= stats.showrooms %></strong></article>
        </section>

        <section class="admin-columns">
            <div class="admin-card">
                <h2>Yêu cầu báo giá mới</h2>
                <table>
                    <thead><tr><th>Khách hàng</th><th>Xe</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                        <% quotes.forEach(item => { %>
                            <tr>
                                <td><%= item.ho_ten %><br><small><%= item.so_dien_thoai %></small></td>
                                <td><%= item.ten_xe || 'Chưa chọn xe' %></td>
                                <td><%= item.trang_thai %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="admin-card">
                <h2>Lịch lái thử mới</h2>
                <table>
                    <thead><tr><th>Khách hàng</th><th>Xe</th><th>Thời gian</th></tr></thead>
                    <tbody>
                        <% testDrives.forEach(item => { %>
                            <tr>
                                <td><%= item.ho_ten %><br><small><%= item.so_dien_thoai %></small></td>
                                <td><%= item.ten_xe %></td>
                                <td><%= item.ngay_muon_lai ? item.ngay_muon_lai.toISOString().slice(0, 10) : '' %> <%= item.gio_muon_lai %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>
</body>
</html>
