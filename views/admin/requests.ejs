<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Quản lý yêu cầu khách hàng' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>

<body>
    <% const statusLabel={ moi: 'Mới' , dang_xu_ly: 'Đang xử lý' , da_lien_he: 'Đã liên hệ' , da_xac_nhan: 'Đã xác nhận'
        , hoan_tat: 'Hoàn tất' , huy: 'Hủy' }; const typeLabel={ bao_gia: 'Báo giá' , lai_thu: 'Lái thử' }; const
        activeStatuses=['moi', 'dang_xu_ly' ]; const requestSections=[ { key: 'bao_gia' , title: 'Yêu cầu báo giá' ,
        desc: 'Khách cần tư vấn giá bán, chi phí lăn bánh, trả góp hoặc ưu đãi.' , items: quoteRequests || [] }, {
        key: 'lai_thu' , title: 'Lịch lái thử' ,
        desc: 'Khách đã chọn xe, đại lý và thời gian mong muốn để trải nghiệm xe.' , items: testDriveRequests || [] }
        ].filter((section)=> filter.loai === 'tat_ca' || filter.loai === section.key);
        %>
        <main class="admin-page">
            <aside class="admin-sidebar">
                <a class="admin-brand" href="/trang-chu">Showroom</a>
                <a href="/admin/xe">Quản lý xe</a>
                <a href="/admin/yeu-cau" class="is-active">Báo giá / Lái thử</a>
                <a href="/admin/panel">Quản lý panel</a>
                <a href="/admin/dai-ly">Quản lý đại lý</a>
                <a href="/admin/tin-tuc">Quản lý tin tức</a>
                <a href="/trang-chu">Xem trang chủ</a>
            </aside>

            <section class="admin-content">
                <div class="admin-heading">
                    <div>
                        <p>Admin</p>
                        <h1>Báo giá / Lái thử</h1>
                    </div>
                    <a href="/bao-gia">Mở form báo giá</a>
                </div>

                <% if (success) { %>
                    <div class="admin-alert success">
                        <%= success %>
                    </div>
                    <% } %>
                        <% if (error) { %>
                            <div class="admin-alert error">
                                <%= error %>
                            </div>
                            <% } %>

                                <form class="admin-request-filter" action="/admin/yeu-cau" method="get">
                                    <label>
                                        Loại yêu cầu
                                        <select name="loai">
                                            <option value="tat_ca" <%=filter.loai==='tat_ca' ? 'selected' : '' %>>Tất cả
                                            </option>
                                            <option value="bao_gia" <%=filter.loai==='bao_gia' ? 'selected' : '' %>>Báo
                                                giá</option>
                                            <option value="lai_thu" <%=filter.loai==='lai_thu' ? 'selected' : '' %>>Lái
                                                thử</option>
                                        </select>
                                    </label>
                                    <label>
                                        Trạng thái
                                        <select name="trang_thai">
                                            <option value="tat_ca" <%=filter.trang_thai==='tat_ca' ? 'selected' : '' %>
                                                >Tất cả</option>
                                            <option value="moi" <%=filter.trang_thai==='moi' ? 'selected' : '' %>>Mới
                                            </option>
                                            <option value="dang_xu_ly" <%=filter.trang_thai==='dang_xu_ly' ? 'selected'
                                                : '' %>>Đang xử lý</option>
                                            <option value="da_lien_he" <%=filter.trang_thai==='da_lien_he' ? 'selected'
                                                : '' %>>Đã liên hệ</option>
                                            <option value="da_xac_nhan" <%=filter.trang_thai==='da_xac_nhan'
                                                ? 'selected' : '' %>>Đã xác nhận</option>
                                            <option value="hoan_tat" <%=filter.trang_thai==='hoan_tat' ? 'selected' : ''
                                                %>>Hoàn tất</option>
                                            <option value="huy" <%=filter.trang_thai==='huy' ? 'selected' : '' %>>Hủy
                                            </option>
                                        </select>
                                    </label>
                                    <button type="submit">Lọc yêu cầu</button>
                                </form>

                                <% requestSections.forEach((section)=> { %>
                                    <% const pendingItems=section.items.filter((item)=>
                                        activeStatuses.includes(item.trang_thai)); %>
                                        <% const processedItems=section.items.filter((item)=>
                                            !activeStatuses.includes(item.trang_thai)); %>
                                            <section class="admin-request-section">
                                                <div class="admin-request-section-head">
                                                    <div>
                                                        <span>
                                                            <%= section.items.length %> yêu cầu
                                                        </span>
                                                        <h2>
                                                            <%= section.title %>
                                                        </h2>
                                                        <p>
                                                            <%= section.desc %>
                                                        </p>
                                                    </div>
                                                </div>

                                                <% [ { title: 'Cần xử lý' , items: pendingItems,
                                                    empty: 'Không có yêu cầu mới cần xử lý.' }, { title: 'Đã xử lý' ,
                                                    items: processedItems, empty: 'Chưa có yêu cầu đã xử lý.' }
                                                    ].forEach((group)=> { %>
                                                    <div
                                                        class="admin-request-group <%= group.title === 'Đã xử lý' ? 'is-processed' : '' %>">
                                                        <h3>
                                                            <%= group.title %>
                                                        </h3>
                                                        <% if (group.items.length) { %>
                                                            <div class="admin-request-list">
                                                                <% group.items.forEach((item)=> { %>
                                                                    <article class="admin-request-card">
                                                                        <div class="admin-request-media">
                                                                            <img src="/images/<%= item.anh_dai_dien || 'no-car.jpg' %>"
                                                                                alt="<%= item.ten_xe || 'Xe' %>">
                                                                            <span
                                                                                class="request-type <%= item.loai_yeu_cau %>">
                                                                                <%= typeLabel[item.loai_yeu_cau] %>
                                                                            </span>
                                                                        </div>
                                                                        <div class="admin-request-main">
                                                                            <div class="admin-request-title">
                                                                                <div>
                                                                                    <h2>
                                                                                        <%= item.ho_ten %>
                                                                                    </h2>
                                                                                    <p>
                                                                                        <%= item.ten_xe
                                                                                            || 'Xe đã bị xóa' %>
                                                                                    </p>
                                                                                </div>
                                                                                <span class="request-status">
                                                                                    <%= statusLabel[item.trang_thai] ||
                                                                                        item.trang_thai %>
                                                                                </span>
                                                                            </div>

                                                                            <dl class="admin-request-info">
                                                                                <div>
                                                                                    <dt>Điện thoại</dt>
                                                                                    <dd><a
                                                                                            href="tel:<%= item.so_dien_thoai %>">
                                                                                            <%= item.so_dien_thoai %>
                                                                                        </a></dd>
                                                                                </div>
                                                                                <div>
                                                                                    <dt>Email</dt>
                                                                                    <dd><a
                                                                                            href="mailto:<%= item.email %>">
                                                                                            <%= item.email %>
                                                                                        </a></dd>
                                                                                </div>
                                                                                <div>
                                                                                    <dt>Tỉnh/Thành</dt>
                                                                                    <dd>
                                                                                        <%= item.thanh_pho %>
                                                                                    </dd>
                                                                                </div>
                                                                                <div>
                                                                                    <dt>Thời gian gửi</dt>
                                                                                    <dd>
                                                                                        <%= formatDateTime(item.ngay_tao)
                                                                                            %>
                                                                                    </dd>
                                                                                </div>
                                                                                <% if (item.loai_yeu_cau==='bao_gia' ) {
                                                                                    %>
                                                                                    <div>
                                                                                        <dt>Nội dung</dt>
                                                                                        <dd>
                                                                                            <%= item.noi_dung
                                                                                                || 'Khách chưa ghi thêm nội dung.'
                                                                                                %>
                                                                                        </dd>
                                                                                    </div>
                                                                                    <% } else { %>
                                                                                        <div>
                                                                                            <dt>Đại lý</dt>
                                                                                            <dd>
                                                                                                <%= item.dai_ly %>
                                                                                            </dd>
                                                                                        </div>
                                                                                        <div>
                                                                                            <dt>Lịch mong muốn</dt>
                                                                                            <dd>
                                                                                                <%= item.ngay_muon_lai
                                                                                                    || 'Chưa chọn ngày'
                                                                                                    %>
                                                                                                    <%= item.gio_muon_lai
                                                                                                        || '' %>
                                                                                            </dd>
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <div>
                                                                                                <dt>Nhận tiếp thị</dt>
                                                                                                <dd>
                                                                                                    <%= item.dong_y_tiep_thi
                                                                                                        ? 'Có' : 'Không'
                                                                                                        %>
                                                                                                </dd>
                                                                                            </div>
                                                                            </dl>

                                                                            <form class="admin-request-actions"
                                                                                action="/admin/yeu-cau/<%= item.loai_yeu_cau === 'lai_thu' ? 'lai-thu' : 'bao-gia' %>/<%= item.id %>/cap-nhat"
                                                                                method="post">
                                                                                <label>
                                                                                    Trạng thái xử lý
                                                                                    <select name="trang_thai">
                                                                                        <option value="moi"
                                                                                            <%=item.trang_thai==='moi'
                                                                                            ? 'selected' : '' %>>Mới
                                                                                        </option>
                                                                                        <option value="dang_xu_ly"
                                                                                            <%=item.trang_thai==='dang_xu_ly'
                                                                                            ? 'selected' : '' %>>Đang xử
                                                                                            lý</option>
                                                                                        <% if
                                                                                            (item.loai_yeu_cau==='bao_gia'
                                                                                            ) { %>
                                                                                            <option value="da_lien_he"
                                                                                                <%=item.trang_thai==='da_lien_he'
                                                                                                ? 'selected' : '' %>>Đã
                                                                                                liên hệ</option>
                                                                                            <% } else { %>
                                                                                                <option
                                                                                                    value="da_xac_nhan"
                                                                                                    <%=item.trang_thai==='da_xac_nhan'
                                                                                                    ? 'selected' : '' %>
                                                                                                    >Đã xác nhận
                                                                                                </option>
                                                                                                <% } %>
                                                                                                    <option
                                                                                                        value="hoan_tat"
                                                                                                        <%=item.trang_thai==='hoan_tat'
                                                                                                        ? 'selected'
                                                                                                        : '' %>>Hoàn tất
                                                                                                    </option>
                                                                                                    <option value="huy"
                                                                                                        <%=item.trang_thai==='huy'
                                                                                                        ? 'selected'
                                                                                                        : '' %>>Hủy
                                                                                                    </option>
                                                                                    </select>
                                                                                </label>
                                                                                <label>
                                                                                    Ghi chú nội bộ
                                                                                    <textarea name="ghi_chu_admin"
                                                                                        rows="3"
                                                                                        placeholder="Ví dụ: đã gọi lần 1, khách hẹn gọi lại chiều mai"><%= item.ghi_chu_admin || '' %></textarea>
                                                                                </label>
                                                                                <button type="submit">Lưu xử lý</button>
                                                                            </form>
                                                                            <form class="admin-request-delete"
                                                                                action="/admin/yeu-cau/<%= item.loai_yeu_cau === 'lai_thu' ? 'lai-thu' : 'bao-gia' %>/<%= item.id %>/xoa"
                                                                                method="post"
                                                                                onsubmit="return confirm('Xóa yêu cầu này khỏi danh sách admin?');">
                                                                                <button type="submit">Xóa yêu
                                                                                    cầu</button>
                                                                            </form>
                                                                        </div>
                                                                    </article>
                                                                    <% }) %>
                                                            </div>
                                                            <% } else { %>
                                                                <p class="empty-state">
                                                                    <%= group.empty %>
                                                                </p>
                                                                <% } %>
                                                    </div>
                                                    <% }) %>
                                            </section>
                                            <% }) %>
            </section>
        </main>
</body>

</html>