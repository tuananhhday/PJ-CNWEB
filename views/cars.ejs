<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/showroom.css">
</head>
<body>
<%- include('partials/site-nav') %>

<main class="page-shell">
    <section class="page-title">
        <p class="eyebrow">Sản phẩm</p>
        <h1>Danh sách xe đang bán</h1>
        <p>Chọn mẫu xe để xem thông số, màu sắc, giá bán và gửi yêu cầu tư vấn.</p>
    </section>

    <section class="car-grid">
        <% cars.forEach(car => { %>
            <article class="vehicle-card">
                <img src="/images/<%= car.anh_dai_dien || 'ford-everest.jpg' %>" alt="<%= car.ten_xe %>">
                <div class="vehicle-content">
                    <p><%= car.ten_hang %> · <%= car.ten_loai %></p>
                    <h3><%= car.ten_xe %></h3>
                    <ul class="mini-specs">
                        <li><%= car.dong_co || 'Đang cập nhật' %></li>
                        <li><%= car.hop_so || 'Đang cập nhật' %></li>
                        <li><%= car.so_cho_ngoi || '-' %> chỗ</li>
                    </ul>
                    <strong>Từ <%= formatPrice(car.gia_ban) %></strong>
                    <div class="card-actions">
                        <a href="/xe/<%= car.duong_dan %>">Xem thêm</a>
                        <a href="/bao-gia?xe_id=<%= car.id %>">Báo giá</a>
                    </div>
                </div>
            </article>
        <% }) %>
    </section>
</main>

<%- include('partials/site-footer') %>
</body>
</html>
