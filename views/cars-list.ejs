<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Danh sách xe | Showroom Double Anh' %></title>
    <meta name="description" content="Xem toàn bộ các mẫu xe đang có sẵn tại Showroom Double Anh. Tìm kiếm, lọc theo dòng xe và xem chi tiết từng mẫu xe.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css?v=public-nav-mobile-20260603">
    <style>
        /* ================================================================
           CARS LIST PAGE – PREMIUM DESIGN
           ================================================================ */
        .cl-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #0284c7 100%);
            padding: 60px 32px 48px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .cl-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 70% 50%, rgba(2,132,199,0.25) 0%, transparent 70%);
        }
        .cl-hero-inner { position: relative; z-index: 1; max-width: 700px; margin: 0 auto; }
        .cl-hero-badge {
            display: inline-block;
            background: rgba(2,132,199,0.2);
            border: 1px solid rgba(2,132,199,0.4);
            color: #7dd3fc;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 5px 14px;
            border-radius: 999px;
            margin-bottom: 16px;
        }
        .cl-hero h1 {
            font-family: var(--font-title);
            font-size: clamp(28px, 4vw, 46px);
            font-weight: 700;
            color: #f8fafc;
            line-height: 1.1;
            margin-bottom: 12px;
            letter-spacing: -0.022em;
        }
        .cl-hero h1 span { color: #38bdf8; }
        .cl-hero p {
            color: #94a3b8;
            font-size: 16px;
            line-height: 1.6;
        }

        /* Search bar in hero */
        .cl-search-form {
            display: flex;
            align-items: center;
            max-width: 520px;
            margin: 28px auto 0;
            background: #fff;
            border-radius: 999px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        }
        .cl-search-form input {
            flex: 1;
            height: 50px;
            border: 0;
            outline: none;
            padding: 0 20px;
            font-size: 15px;
            font-family: var(--font-body);
            color: #0f172a;
        }
        .cl-search-form button {
            height: 50px;
            padding: 0 24px;
            border: 0;
            background: #0284c7;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            font-family: var(--font-body);
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .cl-search-form button:hover { background: #0369a1; }
        .cl-search-form button svg { width: 16px; height: 16px; }

        /* ---- layout ---- */
        .cl-layout {
            max-width: 1400px;
            margin: 40px auto 80px;
            padding: 0 24px;
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 32px;
            align-items: start;
        }

        /* ---- sidebar ---- */
        .cl-sidebar {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            position: sticky;
            top: 100px;
            box-shadow: 0 4px 20px -2px rgba(15,23,42,0.07);
        }
        .cl-sidebar-header {
            padding: 18px 20px 12px;
            border-bottom: 1px solid #f1f5f9;
        }
        .cl-sidebar-header p {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #0284c7;
            margin-bottom: 4px;
        }
        .cl-sidebar-header h2 {
            font-family: var(--font-title);
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.015em;
        }
        .cl-type-list { padding: 10px 10px 14px; display: flex; flex-direction: column; gap: 2px; }
        .cl-type-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
            transition: all 0.2s;
            border: none;
            background: transparent;
            cursor: pointer;
            width: 100%;
            text-align: left;
        }
        .cl-type-btn:hover { background: #f0f9ff; color: #0284c7; }
        .cl-type-btn.active { background: #eff6ff; color: #0284c7; }
        .cl-type-btn .cl-badge {
            min-width: 24px;
            height: 20px;
            background: #e0f2fe;
            color: #0284c7;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 6px;
            transition: all 0.2s;
        }
        .cl-type-btn.active .cl-badge,
        .cl-type-btn:hover .cl-badge { background: #0284c7; color: #fff; }
        .cl-type-all { border-top: 1px solid #f1f5f9; margin-top: 6px; padding-top: 10px; }

        /* ---- main ---- */
        .cl-main {}
        .cl-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            gap: 16px;
            flex-wrap: wrap;
        }
        .cl-result-info { font-size: 14px; color: #64748b; }
        .cl-result-info strong { color: #0f172a; font-weight: 700; }
        .cl-active-filter {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
            font-size: 13px;
            font-weight: 600;
            padding: 5px 12px 5px 14px;
            border-radius: 999px;
        }
        .cl-active-filter a {
            display: inline-flex;
            align-items: center;
            color: #1d4ed8;
            font-size: 16px;
            line-height: 1;
            transition: color 0.2s;
            text-decoration: none;
        }
        .cl-active-filter a:hover { color: #ef4444; }

        /* ---- car grid ---- */
        .cl-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }
        .cl-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
            box-shadow: 0 2px 8px rgba(15,23,42,0.05);
            display: flex;
            flex-direction: column;
        }
        .cl-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px -8px rgba(2,132,199,0.18);
            border-color: #bae6fd;
        }
        .cl-card-img {
            width: 100%;
            height: 190px;
            object-fit: cover;
            background: #f1f5f9;
            transition: transform 0.4s ease;
            display: block;
        }
        .cl-card:hover .cl-card-img { transform: scale(1.04); }
        .cl-card-img-wrap { overflow: hidden; }
        .cl-card-body { padding: 18px 18px 14px; flex: 1; display: flex; flex-direction: column; gap: 6px; }
        .cl-card-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #0284c7;
        }
        .cl-card-name {
            font-family: var(--font-title);
            font-size: 18px;
            font-weight: 600;
            color: #0f172a;
            line-height: 1.25;
            letter-spacing: -0.01em;
        }
        .cl-card-desc {
            font-size: 13px;
            color: #64748b;
            line-height: 1.5;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 6px;
        }
        .cl-card-specs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 4px;
        }
        .cl-spec-tag {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            color: #475569;
            padding: 3px 8px;
        }
        .cl-card-footer {
            padding: 12px 18px 16px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .cl-price {
            font-family: var(--font-title);
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.01em;
        }
        .cl-price-hint { font-size: 11px; color: #94a3b8; font-weight: 400; display: block; }
        .cl-btn-detail {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #0284c7;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            font-family: var(--font-body);
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .cl-btn-detail:hover { background: #0369a1; transform: translateY(-1px); color: #fff; }
        .cl-btn-detail svg { width: 14px; height: 14px; }

        /* empty state */
        .cl-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 80px 24px;
        }
        .cl-empty-icon { font-size: 64px; margin-bottom: 16px; }
        .cl-empty h3 { font-family: var(--font-title); font-size: 22px; color: #0f172a; margin-bottom: 8px; font-weight: 700; letter-spacing: -0.015em; }
        .cl-empty p { color: #64748b; font-size: 15px; }
        .cl-empty a {
            display: inline-block;
            margin-top: 20px;
            background: #0284c7;
            color: #fff;
            font-weight: 700;
            padding: 10px 24px;
            border-radius: 8px;
            transition: background 0.2s;
        }
        .cl-empty a:hover { background: #0369a1; }

        /* responsive */
        @media (max-width: 900px) {
            .cl-layout { grid-template-columns: 1fr; }
            .cl-sidebar { position: static; }
            .cl-type-list { flex-direction: row; flex-wrap: wrap; padding: 10px; }
            .cl-type-btn { width: auto; }
        }
        @media (max-width: 540px) {
            .cl-grid { grid-template-columns: 1fr; }
            .cl-hero { padding: 40px 16px 36px; }
        }
    </style>
</head>
<body>
<%- include('partials/site-nav') %>

<main id="main-content">
    <!-- ── HERO ── -->
    <section class="cl-hero">
        <div class="cl-hero-inner">
            <span class="cl-hero-badge">Showroom Double Anh</span>
            <h1>
                <% if (activeLoai) { %>
                    Dòng xe <span><%= activeLoai %></span>
                <% } else { %>
                    Tất cả <span>dòng xe</span> có sẵn
                <% } %>
            </h1>
            <p>Khám phá các mẫu xe đang có tại showroom — Xem thông số, so sánh và nhận báo giá ngay hôm nay.</p>

            <form class="cl-search-form" action="/danh-sach-xe" method="GET">
                <% if (activeLoai) { %>
                    <input type="hidden" name="loai" value="<%= activeLoai %>">
                <% } %>
                <input type="text" name="tim_kiem" placeholder="Tìm tên xe, phiên bản..." value="<%= timKiem || '' %>" autocomplete="off">
                <button type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.031 16.617L22.314 20.899L20.899 22.314L16.617 18.031C15.077 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.077 18.031 16.617ZM16.025 15.875C17.248 14.615 18 12.896 18 11C18 7.132 14.868 4 11 4C7.132 4 4 7.132 4 11C4 14.868 7.132 18 11 18C12.896 18 14.615 17.248 15.875 16.025L16.025 15.875Z"></path>
                    </svg>
                    Tìm kiếm
                </button>
            </form>
        </div>
    </section>

    <!-- ── MAIN LAYOUT ── -->
    <div class="cl-layout">

        <!-- ── SIDEBAR ── -->
        <aside class="cl-sidebar" aria-label="Lọc theo dòng xe">
            <div class="cl-sidebar-header">
                <p>Phân loại</p>
                <h2>Dòng xe</h2>
            </div>
            <div class="cl-type-list">
                <% typeCounts.forEach(tc => { %>
                    <a href="/danh-sach-xe<%= timKiem ? '?tim_kiem=' + encodeURIComponent(timKiem) + '&loai=' + encodeURIComponent(tc.ten_loai) : '?loai=' + encodeURIComponent(tc.ten_loai) %>"
                       class="cl-type-btn <%= activeLoai === tc.ten_loai ? 'active' : '' %>">
                        <span><%= tc.ten_loai %></span>
                        <span class="cl-badge"><%= tc.so_luong %></span>
                    </a>
                <% }); %>
                <div class="cl-type-all">
                    <a href="/danh-sach-xe<%= timKiem ? '?tim_kiem=' + encodeURIComponent(timKiem) : '' %>"
                       class="cl-type-btn <%= !activeLoai ? 'active' : '' %>">
                        <span>Tất cả dòng xe</span>
                        <span class="cl-badge"><%= typeCounts.reduce((s, t) => s + t.so_luong, 0) %></span>
                    </a>
                </div>
            </div>
        </aside>

        <!-- ── MAIN GRID ── -->
        <section>
            <!-- top bar -->
            <div class="cl-topbar">
                <p class="cl-result-info">
                    Hiển thị <strong><%= cars.length %></strong> mẫu xe
                    <% if (activeLoai) { %> trong dòng <strong><%= activeLoai %></strong><% } %>
                    <% if (timKiem) { %> · kết quả cho "<strong><%= timKiem %></strong>"<% } %>
                </p>
                <% if (activeLoai || timKiem) { %>
                <span class="cl-active-filter">
                    <% if (activeLoai) { %><%= activeLoai %><% } %>
                    <% if (timKiem) { %><% if (activeLoai) { %> · <% } %>"<%= timKiem %>"<% } %>
                    <a href="/danh-sach-xe" title="Xóa bộ lọc">&times;</a>
                </span>
                <% } %>
            </div>

            <!-- grid -->
            <div class="cl-grid">
                <% if (cars.length > 0) { %>
                    <% cars.forEach(car => { %>
                        <%
                        const imgSrc = (car.anh_dai_dien && (car.anh_dai_dien.startsWith('http') || car.anh_dai_dien.startsWith('/')))
                            ? car.anh_dai_dien
                            : '/images/' + (car.anh_dai_dien || 'no-car.jpg');
                        const carUrl = '/xe/' + (car.duong_dan || car.id);
                        %>
                        <article class="cl-card">
                            <a href="<%= carUrl %>" class="cl-card-img-wrap">
                                <img class="cl-card-img" src="<%= imgSrc %>" alt="<%= car.ten_xe %>" loading="lazy">
                            </a>
                            <div class="cl-card-body">
                                <span class="cl-card-label"><%= car.ten_hang %> · <%= car.ten_loai %></span>
                                <h3 class="cl-card-name"><%= car.ten_xe %></h3>
                                <% if (car.phien_ban) { %>
                                    <p style="font-size:12px;color:#94a3b8;font-weight:600;margin-top:-2px;"><%= car.phien_ban %></p>
                                <% } %>
                                <p class="cl-card-desc"><%= car.mo_ta_ngan || 'Thông tin đang được cập nhật.' %></p>
                                <div class="cl-card-specs">
                                    <% if (car.nhien_lieu) { %>
                                        <span class="cl-spec-tag">⛽ <%= car.nhien_lieu %></span>
                                    <% } %>
                                    <% if (car.so_cho_ngoi) { %>
                                        <span class="cl-spec-tag">👥 <%= car.so_cho_ngoi %> chỗ</span>
                                    <% } %>
                                    <% if (car.hop_so) { %>
                                        <span class="cl-spec-tag">⚙️ <%= car.hop_so %></span>
                                    <% } %>
                                    <% if (car.nam_san_xuat) { %>
                                        <span class="cl-spec-tag">📅 <%= car.nam_san_xuat %></span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="cl-card-footer">
                                <div>
                                    <span class="cl-price">Từ <%= formatPrice(car.gia_ban) %></span>
                                    <span class="cl-price-hint">Giá chưa bao gồm phụ phí</span>
                                </div>
                                <a href="<%= carUrl %>" class="cl-btn-detail">
                                    Chi tiết
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M13.172 12L8.222 7.05 9.636 5.636 16 12l-6.364 6.364-1.414-1.414z"/>
                                    </svg>
                                </a>
                            </div>
                        </article>
                    <% }); %>
                <% } else { %>
                    <div class="cl-empty">
                        <div class="cl-empty-icon">🚗</div>
                        <h3>Không tìm thấy xe nào</h3>
                        <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm của bạn.</p>
                        <a href="/danh-sach-xe">Xem tất cả xe</a>
                    </div>
                <% } %>
            </div>
        </section>
    </div>
</main>

<%- include('partials/site-footer') %>
<script src="/javascripts/nav-search.js"></script>
</body>
</html>
