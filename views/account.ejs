<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/showroom.css">
</head>
<body>
<%- include('partials/site-nav') %>

<main class="page-shell">
    <section class="page-title">
        <p class="eyebrow">Tài khoản khách hàng</p>
        <h1>Hộp thư của tôi</h1>
        <p>Theo dõi trạng thái yêu cầu báo giá và lịch lái thử. Khi admin xử lý, trạng thái ở đây sẽ được cập nhật.</p>
    </section>

    <section class="account-grid">
        <div class="account-panel">
            <h2>Yêu cầu báo giá</h2>
            <% if (quotes.length === 0) { %>
                <p class="empty-text">Bạn chưa gửi yêu cầu báo giá nào.</p>
            <% } %>

            <% quotes.forEach(item => { %>
                <article class="inbox-item">
                    <div>
                        <h3><%= item.ten_xe || 'Chưa chọn mẫu xe' %></h3>
                        <p><%= item.noi_dung || 'Yêu cầu tư vấn báo giá' %></p>
                        <small>Ngày gửi: <%= item.ngay_tao ? item.ngay_tao.toISOString().slice(0, 10) : '' %></small>
                    </div>
                    <span class="status-badge status-<%= item.trang_thai %>"><%= item.trang_thai %></span>
                </article>
            <% }) %>
        </div>

        <div class="account-panel">
            <h2>Đăng ký lái thử</h2>
            <% if (testDrives.length === 0) { %>
                <p class="empty-text">Bạn chưa đăng ký lịch lái thử nào.</p>
            <% } %>

            <% testDrives.forEach(item => { %>
                <article class="inbox-item">
                    <div>
                        <h3><%= item.ten_xe %></h3>
                        <p><%= item.dia_diem_showroom || 'Showroom đang xác nhận' %></p>
                        <small>
                            Lịch hẹn:
                            <%= item.ngay_muon_lai ? item.ngay_muon_lai.toISOString().slice(0, 10) : '' %>
                            <%= item.gio_muon_lai || '' %>
                        </small>
                    </div>
                    <span class="status-badge status-<%= item.trang_thai %>"><%= item.trang_thai %></span>
                </article>
            <% }) %>
        </div>
    </section>
</main>

<%- include('partials/site-footer') %>
</body>
</html>
