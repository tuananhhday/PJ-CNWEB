<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || post.tieu_de %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/news.css">
    <!-- Quill stylesheet to render rich text elements correctly -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>
<body>
<%- include('partials/site-nav') %>
 
<main id="main-content" class="news-detail-page">
    <div class="news-detail-back">
        <a href="/tin-tuc" class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Quay lại Tin tức
        </a>
    </div>

    <article class="news-article-detail">
        <div class="news-detail-category">TIN TỨC SỰ KIỆN</div>
        <h1><%= post.tieu_de %></h1>
        
        <div class="news-detail-meta">
            <span class="meta-author">👤 Tác giả: <strong><%= post.tac_gia || 'Showroom Double Anh' %></strong></span>
            <span class="meta-divider">•</span>
            <span class="meta-date">🕒 <%= formatDateTime(post.ngay_tao) %></span>
        </div>

        <% if (post.anh_dai_dien) { %>
            <div class="post-detail-image-wrapper">
                <img class="post-detail-image" src="/images/<%= post.anh_dai_dien %>" alt="<%= post.tieu_de %>" onerror="this.src='/images/no-car.jpg';">
            </div>
        <% } %>

        <div class="post-body ql-editor" style="padding: 0; line-height: 1.8;">
            <% if (post.noi_dung.includes('<p>') || post.noi_dung.includes('</div>') || post.noi_dung.includes('<br>') || post.noi_dung.includes('</p>')) { %>
                <%- post.noi_dung %>
            <% } else { %>
                <% post.noi_dung.split(/\r?\n/).filter(Boolean).forEach((paragraph) => { %>
                    <p><%= paragraph %></p>
                <% }) %>
            <% } %>
        </div>
    </article>
</main>

<%- include('partials/site-footer') %>
<script src="/javascripts/nav-search.js"></script>
</body>
</html>
