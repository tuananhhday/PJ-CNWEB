<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/showroom.css">
</head>
<body>
<%- include('partials/site-nav') %>

<main class="page-shell">
    <section class="page-title">
        <p class="eyebrow">Đại lý</p>
        <h1>Liên hệ showroom</h1>
        <p>Tìm địa chỉ showroom, số điện thoại và thời gian làm việc để được hỗ trợ nhanh nhất.</p>
    </section>

    <section class="contact-grid">
        <% if (showrooms.length > 0) { %>
            <% showrooms.forEach(showroom => { %>
                <article class="contact-card">
                    <h2><%= showroom.ten_showroom %></h2>
                    <p><strong>Địa chỉ:</strong> <%= showroom.dia_chi %></p>
                    <p><strong>Điện thoại:</strong> <a href="tel:<%= showroom.so_dien_thoai %>"><%= showroom.so_dien_thoai %></a></p>
                    <p><strong>Email:</strong> <a href="mailto:<%= showroom.email %>"><%= showroom.email %></a></p>
                    <p><strong>Giờ mở cửa:</strong> <%= showroom.gio_mo_cua || '08:00 - 18:00' %></p>
                    <a href="<%= showroom.ban_do || '#' %>" class="primary-btn">Xem bản đồ</a>
                </article>
            <% }) %>
        <% } else { %>
            <article class="contact-card">
                <h2>Showroom Tuấn Anh</h2>
                <p><strong>Điện thoại:</strong> <a href="tel:0963709396">0963 709 396</a></p>
                <p><strong>Email:</strong> showroom@gmail.com</p>
                <p><strong>Giờ mở cửa:</strong> 08:00 - 18:00</p>
            </article>
        <% } %>
    </section>
</main>

<%- include('partials/site-footer') %>
</body>
</html>
