<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Showroom Double Anh' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="home-landing">
<%- include('partials/site-nav') %>

<main id="main-content">
    <section class="front-panel" aria-label="Showroom ô tô Double Anh">
        <% const displayPanels = panels && panels.length ? panels : []; %>

        <% if (displayPanels.length) { %>
            <% displayPanels.forEach((panel, index) => { %>
                <% const panelImage = panel.duong_dan_anh || 'no-car.jpg'; %>
                <% const panelImageSrc = /^https?:\/\//i.test(panelImage) || panelImage.startsWith('/') ? panelImage : '/images/' + panelImage; %>
                <article class="front-slide <%= index === 0 ? 'is-active' : '' %>" data-slide>
                    <div class="slide-media">
                        <img src="<%= panelImageSrc %>" alt="Không gian trưng bày xe tại showroom">
                        <div class="slide-overlay"></div>
                    </div>
                    
                    <div class="slide-cta">
                        <a href="/bao-gia" class="btn-quote">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            Nhận báo giá
                        </a>
                        <a href="/dang-ky-lai-thu" class="btn-drive">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
                            Lịch lái thử
                        </a>
                    </div>
                </article>
            <% }) %>

            <% if (displayPanels.length > 1) { %>
                <button class="front-arrow front-arrow-left" type="button" data-prev aria-label="Ảnh trước">&#8249;</button>
                <button class="front-arrow front-arrow-right" type="button" data-next aria-label="Ảnh tiếp theo">&#8250;</button>

                <div class="front-dots" aria-label="Chọn ảnh">
                    <% displayPanels.forEach((panel, index) => { %>
                        <button class="<%= index === 0 ? 'is-active' : '' %>" type="button" data-goto="<%= index %>" aria-label="Panel <%= index + 1 %>"></button>
                    <% }) %>
                </div>
            <% } %>
        <% } else { %>
            <div class="front-empty">
                <p>Chưa có ảnh panel. Vào Admin để thêm ảnh panel trang chủ.</p>
            </div>
        <% } %>
    </section>

    <section class="featured-cars" aria-label="Thông tin xe nổi bật">
        <% const carList = cars && cars.length ? cars : []; %>
        <% const carTypes = []; %>
        <% carList.forEach((car) => { %>
            <% const typeName = car.ten_loai || 'Khác'; %>
            <% if (!carTypes.includes(typeName)) carTypes.push(typeName); %>
        <% }) %>

        <% if (carList.length) { %>
            <div class="featured-tabs" aria-label="Chọn nhóm xe">
                <% carTypes.forEach((typeName, index) => { %>
                    <% const typeCount = carList.filter((car) => (car.ten_loai || 'Khác') === typeName).length; %>
                    <button class="<%= index === 0 ? 'is-active' : '' %>" type="button" data-feature-filter="<%= typeName %>">
                        <%= typeName %> (<%= typeCount %>)
                    </button>
                <% }) %>
            </div>

            <div class="featured-stage">
                <% carList.forEach((car, index) => { %>
                    <% const featureType = car.ten_loai || 'Khác'; %>
                    <% const carUrl = '/xe/' + (car.duong_dan || car.id); %>
                    <article class="featured-car <%= index === 0 ? 'is-active' : '' %>" data-feature-car data-feature-type="<%= featureType %>">
                        <div class="featured-copy">
                            <span><%= car.ten_hang %> <%= car.ten_loai %></span>
                            <h2><%= car.ten_xe %></h2>
                            <p><%= car.mo_ta_ngan || 'Thông tin xe đang được cập nhật.' %></p>
                            <strong><%= formatPrice(car.gia_ban) %></strong>
                            <em>Ưu đãi và lịch lái thử đang chờ bạn</em>
                            <a href="<%= carUrl %>">Xem tất cả</a>
                        </div>

                        <div class="featured-media">
                            <div class="featured-specs">
                                <span>
                                    <svg class="spec-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 8h-1V5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3H8a1 1 0 0 0-1 1v3H5a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-2h2a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-2V9a1 1 0 0 0-1-1z" />
                                        <circle cx="12" cy="13" r="2" />
                                    </svg>
                                    <%= car.dong_co || car.nhien_lieu || 'Động cơ đang cập nhật' %>
                                </span>
                                <span>
                                    <svg class="spec-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="3" />
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                    </svg>
                                    <%= car.hop_so || 'Hộp số đang cập nhật' %>
                                </span>
                                <span>
                                    <svg class="spec-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M7 4h6a3 3 0 0 1 3 3v8h2" />
                                        <path d="M5 15h11a3 3 0 0 1 3 3v2H5v-5z" />
                                        <path d="M9 4V2M13 4V2" />
                                    </svg>
                                    <%= car.so_cho_ngoi ? car.so_cho_ngoi + ' chỗ' : 'Số chỗ đang cập nhật' %>
                                </span>
                            </div>
                            <img src="/images/<%= car.anh_dai_dien || 'no-car.jpg' %>" alt="<%= car.ten_xe %>">
                        </div>
                    </article>
                <% }) %>

                <div class="featured-controls">
                    <span><strong data-feature-current>1</strong> / <span data-feature-total><%= carList.length %></span></span>
                    <button type="button" data-feature-prev aria-label="Xe trước">&#8592;</button>
                    <button type="button" data-feature-next aria-label="Xe tiếp theo">&#8594;</button>
                </div>
            </div>
        <% } else { %>
            <p class="empty-state">Chưa có xe trong database. Hãy vào /admin/xe để thêm xe.</p>
        <% } %>
    </section>

    <section class="home-cars" aria-label="Danh sách xe của showroom">
        <div class="home-cars-heading">
            <p>Danh sách xe</p>
            <h2>Tất cả mẫu xe đang có tại showroom.</h2>
            <span>Xem nhanh hình ảnh, giá bán, phiên bản và thông tin cơ bản của từng mẫu xe.</span>
        </div>

        <div class="home-car-grid">
            <% if (cars && cars.length) { %>
                <% cars.forEach((car) => { %>
                    <article class="home-car-card">
                        <a href="/xe/<%= car.duong_dan || car.id %>">
                            <img src="/images/<%= car.anh_dai_dien || 'no-car.jpg' %>" alt="<%= car.ten_xe %>">
                            <span><%= car.ten_hang %> <%= car.ten_loai %></span>
                            <h3><%= car.ten_xe %></h3>
                            <p><%= car.mo_ta_ngan || 'Thông tin xe đang được cập nhật.' %></p>
                            <div class="car-card-meta">
                                <small><%= car.nhien_lieu || 'Nhiên liệu đang cập nhật' %></small>
                                <small><%= car.so_cho_ngoi ? car.so_cho_ngoi + ' chỗ' : 'Số chỗ đang cập nhật' %></small>
                            </div>
                            <strong>Giá từ <%= formatPrice(car.gia_ban) %></strong>
                            <em>Xem chi tiết</em>
                        </a>
                    </article>
                <% }) %>
            <% } else { %>
                <p class="empty-state">Chưa có xe trong database. Hãy vào /admin/xe để thêm xe.</p>
            <% } %>
        </div>
    </section>

    <!-- Why Choose Us / Services Section -->
    <section class="home-features-section" aria-label="Dịch vụ nổi bật">
        <div class="features-heading">
            <p>Tiện ích & Dịch vụ</p>
            <h2>Ưu thế vượt trội của Showroom Double Anh</h2>
            <span>Đồng hành cùng khách hàng từ khâu chọn xe đến dịch vụ bảo dưỡng trọn đời sản phẩm.</span>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <!-- Steering Wheel SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="2" x2="12" y2="22"></line>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </div>
                <h3>Lái thử tận nhà</h3>
                <p>Đăng ký trực tuyến nhanh chóng, chúng tôi hỗ trợ giao xe lái thử đến tận nhà hoàn toàn miễn phí.</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <!-- Credit Card SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                </div>
                <h3>Trả góp ưu đãi</h3>
                <p>Liên kết với nhiều ngân hàng uy tín, hỗ trợ vay mua xe đến 80% giá trị xe, giải ngân nhanh trong 2 giờ.</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <!-- Shield SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <h3>Bảo hành 5 năm</h3>
                <p>Yên tâm tuyệt đối với chính sách bảo hành chính hãng lên tới 5 năm hoặc 150.000 km cùng phụ tùng chính phẩm.</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon-wrapper">
                    <!-- Help/Wrench SVG -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                </div>
                <h3>Cứu hộ khẩn cấp 24/7</h3>
                <p>Đội ngũ hỗ trợ kỹ thuật và cứu hộ đường bộ chuyên nghiệp sẵn sàng trợ giúp bạn 24h mỗi ngày ở bất cứ đâu.</p>
            </div>
        </div>
    </section>

    <style>
        /* Scoped styling to fix distorted images in the homepage news section */
        .home-news-section {
            max-width: 1400px;
            margin: 80px auto;
            padding: 0 24px;
            display: grid;
            grid-template-columns: 1fr 1.2fr 1fr;
            gap: 40px;
        }

        @media (max-width: 1024px) {
            .home-news-section {
                grid-template-columns: 1fr;
                gap: 48px;
            }
        }

        .home-news-section h2 {
            font-family: var(--font-title, 'Outfit', sans-serif);
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 24px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--text-dark, #0f172a);
            color: var(--text-dark, #0f172a);
        }

        /* Left Column: Xem nhiều */
        .home-news-popular {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .home-news-mini {
            display: flex;
            gap: 16px;
            align-items: center;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .home-news-mini .mini-img-wrapper {
            width: 90px;
            height: 68px;
            flex-shrink: 0;
            border-radius: 6px;
            overflow: hidden;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
        }

        .home-news-mini .mini-img-wrapper img {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }

        .home-news-mini span {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 0;
        }

        .home-news-mini strong {
            font-size: 13.5px;
            font-weight: 700;
            line-height: 1.4;
            color: var(--text-dark, #0f172a);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: var(--transition-smooth);
        }

        .home-news-mini:hover strong {
            color: var(--primary, #0284c7);
        }

        .home-news-mini small {
            font-size: 11px;
            color: var(--text-muted, #64748b);
        }

        /* Center Column: Tin mới */
        .home-news-main {
            display: flex;
            flex-direction: column;
        }

        .home-news-main-scroll {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-height: 600px;
            overflow-y: auto;
            padding-right: 8px;
        }

        /* Stylized scrollbar for Center Column */
        .home-news-main-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .home-news-main-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 3px;
        }
        .home-news-main-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .home-news-main-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .home-news-main-scroll .home-news-main-card {
            height: auto;
            flex-shrink: 0;
        }


        .home-news-main-card {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
            transition: all 0.3s ease;
            height: 100%;
        }

        .home-news-main-card .main-img-wrapper {
            width: 100%;
            height: 240px;
            border-radius: 8px;
            overflow: hidden;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            margin-bottom: 16px;
        }

        .home-news-main-card .main-img-wrapper img {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
            transition: transform 0.5s ease;
        }

        .home-news-main-card strong {
            font-family: var(--font-title, 'Outfit', sans-serif);
            font-size: 18px;
            font-weight: 800;
            line-height: 1.35;
            color: var(--text-dark, #0f172a);
            margin-bottom: 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: var(--transition-smooth);
        }

        .home-news-main-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.05));
            border-color: var(--primary, #0284c7);
        }

        .home-news-main-card:hover .main-img-wrapper img {
            transform: scale(1.03);
        }

        .home-news-main-card:hover strong {
            color: var(--primary, #0284c7);
        }

        .home-news-main-card .main-meta {
            font-size: 11px;
            color: var(--text-muted, #64748b);
            margin-top: auto;
        }

        /* Right Column: Các tin khác */
        .home-news-side {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .home-news-side-scroll {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-height: 600px;
            overflow-y: auto;
            padding-right: 8px;
        }

        /* Stylized scrollbar for Right Column */
        .home-news-side-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .home-news-side-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 3px;
        }
        .home-news-side-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .home-news-side-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .home-news-side-scroll .home-news-card {
            height: auto;
            flex-shrink: 0;
        }

        @media (max-width: 1024px) {
            .home-news-side {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
        }

        @media (max-width: 600px) {
            .home-news-side {
                grid-template-columns: 1fr;
            }
        }

        .home-news-card {
            display: flex;
            flex-direction: column;
            text-decoration: none;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px;
            box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
            transition: all 0.3s ease;
        }

        .home-news-card .side-img-wrapper {
            width: 100%;
            height: 120px;
            border-radius: 6px;
            overflow: hidden;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            margin-bottom: 10px;
        }

        .home-news-card .side-img-wrapper img {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
        }

        .home-news-card strong {
            font-size: 13.5px;
            font-weight: 700;
            line-height: 1.4;
            color: var(--text-dark, #0f172a);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 38px;
            transition: var(--transition-smooth);
        }

        .home-news-card small {
            font-size: 11px;
            color: var(--text-muted, #64748b);
        }

        .home-news-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.05));
            border-color: var(--primary, #0284c7);
        }

        .home-news-card:hover strong {
            color: var(--primary, #0284c7);
        }
    </style>

    <section class="home-news-section" aria-label="Tin tức showroom">
        <% 
        const homePosts = posts && posts.length ? posts : [];
        
        // 1. Center post: newest post overall (index 0)
        const mainPost = homePosts.length ? homePosts[0] : null;
        const otherPosts = homePosts.slice(1);
        
        // 2. Initial selection based on user flags (excluding mainPost since it's from otherPosts)
        let popularPosts = otherPosts.filter(p => Number(p.xem_nhieu)).slice(0, 4);
        let sidePosts = otherPosts.filter(p => Number(p.hien_sidebar)).slice(0, 3);
        
        // 3. Fallback filling to show old posts and prevent them from disappearing:
        // Fill popularPosts (up to 4) preferring posts not already in sidePosts
        for (const post of otherPosts) {
            if (popularPosts.length >= 4) break;
            if (popularPosts.some(x => x.id === post.id)) continue;
            if (!sidePosts.some(x => x.id === post.id)) {
                popularPosts.push(post);
            }
        }
        // Fill remaining popularPosts slots with any other remaining posts
        for (const post of otherPosts) {
            if (popularPosts.length >= 4) break;
            if (!popularPosts.some(x => x.id === post.id)) {
                popularPosts.push(post);
            }
        }
        
        // Fill sidePosts (up to 3) preferring posts not already in popularPosts
        for (const post of otherPosts) {
            if (sidePosts.length >= 3) break;
            if (sidePosts.some(x => x.id === post.id)) continue;
            if (!popularPosts.some(x => x.id === post.id)) {
                sidePosts.push(post);
            }
        }
        // Fill remaining sidePosts slots with any other remaining posts
        for (const post of otherPosts) {
            if (sidePosts.length >= 3) break;
            if (!sidePosts.some(x => x.id === post.id)) {
                sidePosts.push(post);
            }
        }
        %>


        <div class="home-news-column home-news-popular">
            <h2>Xem nhiều</h2>
            <% popularPosts.forEach((post) => { %>
                <a class="home-news-mini" href="/tin-tuc/<%= post.duong_dan %>">
                    <div class="mini-img-wrapper">
                        <img src="/images/<%= post.anh_dai_dien || 'no-car.jpg' %>" alt="<%= post.tieu_de %>" onerror="this.src='/images/no-car.jpg';">
                    </div>
                    <span>
                        <strong><%= post.tieu_de %></strong>
                        <small><%= formatDateTime(post.ngay_tao) %></small>
                    </span>
                </a>
            <% }) %>
        </div>

        <div class="home-news-main">
            <h2>Tin mới</h2>
            <% if (homePosts.length) { %>
                <div class="home-news-main-scroll">
                    <% homePosts.forEach((post) => { %>
                        <a class="home-news-main-card" href="/tin-tuc/<%= post.duong_dan %>">
                            <div class="main-img-wrapper">
                                <img src="/images/<%= post.anh_dai_dien || 'no-car.jpg' %>" alt="<%= post.tieu_de %>" onerror="this.src='/images/no-car.jpg';">
                            </div>
                            <strong><%= post.tieu_de %></strong>
                            <span class="main-meta"><%= formatDateTime(post.ngay_tao) %></span>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-state">Chưa có tin tức nào được đăng.</p>
            <% } %>
        </div>

        <div class="home-news-column home-news-side">
            <h2>Tin tức khác</h2>
            <% if (sidePosts.length) { %>
                <div class="home-news-side-scroll">
                    <% sidePosts.forEach((post) => { %>
                        <a class="home-news-card" href="/tin-tuc/<%= post.duong_dan %>">
                            <div class="side-img-wrapper">
                                <img src="/images/<%= post.anh_dai_dien || 'no-car.jpg' %>" alt="<%= post.tieu_de %>" onerror="this.src='/images/no-car.jpg';">
                            </div>
                            <strong><%= post.tieu_de %></strong>
                            <small><%= formatDateTime(post.ngay_tao) %></small>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="empty-state">Chưa có tin tức nào khác.</p>
            <% } %>
        </div>
    </section>

    <!-- Customer Testimonials Section -->
    <section class="home-testimonials-section" aria-label="Đánh giá từ khách hàng">
        <div class="testimonials-heading">
            <p>Trải nghiệm của khách hàng</p>
            <h2>Khách hàng nói gì về Showroom Double Anh?</h2>
            <span>Đóng góp và ý kiến thực tế của những chủ sở hữu xe tin tưởng lựa chọn dịch vụ của chúng tôi.</span>
        </div>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <div class="testimonial-rating">
                    <% for(let i=0; i<5; i++) { %>
                        <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <% } %>
                </div>
                <p class="testimonial-text">"Tôi rất hài lòng với chất lượng phục vụ tại showroom. Thủ tục mua chiếc Santa Fe trả góp diễn ra vô cùng chuyên nghiệp và nhanh chóng. Nhân viên hỗ trợ nhiệt tình từ khâu chọn xe đến đăng ký biển số."</p>
                <div class="testimonial-user">
                    <div class="user-avatar text-avatar">H</div>
                    <div>
                        <span class="user-name">Nguyễn Văn Hùng</span>
                        <span class="user-info">Chủ xe Hyundai Santa Fe · <small class="verified-tag">✓ Đã mua xe</small></span>
                    </div>
                </div>
            </div>
            
            <div class="testimonial-card">
                <div class="testimonial-rating">
                    <% for(let i=0; i<5; i++) { %>
                        <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <% } %>
                </div>
                <p class="testimonial-text">"Đăng ký lái thử xe Creta tại nhà cực kỳ tiện lợi cho gia đình tôi. Xe được giao đúng giờ, sạch sẽ, bạn tư vấn kỹ thuật giải thích rất cặn kẽ và điềm đạm. Chắc chắn tôi sẽ giới thiệu bạn bè tới đây mua xe."</p>
                <div class="testimonial-user">
                    <div class="user-avatar text-avatar">M</div>
                    <div>
                        <span class="user-name">Trần Thị Mai</span>
                        <span class="user-info">Chủ xe Hyundai Creta · <small class="verified-tag">✓ Đã mua xe</small></span>
                    </div>
                </div>
            </div>
            
            <div class="testimonial-card">
                <div class="testimonial-rating">
                    <% for(let i=0; i<5; i++) { %>
                        <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    <% } %>
                </div>
                <p class="testimonial-text">"Chính sách bảo hành và cứu hộ 24/7 của showroom khiến tôi vô cùng an tâm khi lái xe đi tỉnh xa. Đợt xe tôi gặp sự cố điện nhẹ lúc nửa đêm đã được đội cứu hộ hỗ trợ xử lý ngay lập tức."</p>
                <div class="testimonial-user">
                    <div class="user-avatar text-avatar">N</div>
                    <div>
                        <span class="user-name">Lê Hoàng Nam</span>
                        <span class="user-info">Chủ xe Hyundai Tucson · <small class="verified-tag">✓ Đã mua xe</small></span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/site-footer') %>

<script src="/javascripts/home.js"></script>
<script src="/javascripts/nav-search.js"></script>
</body>
</html>
