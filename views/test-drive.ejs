<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/forms.css">
</head>
<body class="page-form">
<%- include('partials/site-nav') %>

<main id="main-content">
    <section class="form-section">
        <div class="form-container">
            <div class="form-header">
                <span>Lái thử xe</span>
                <h1>Đặt lịch lái thử</h1>
                <p>Chọn mẫu xe và đại lý phù hợp để showroom chuẩn bị xe, tư vấn tính năng và xác nhận lịch hẹn với bạn.</p>
            </div>

            <% const driveFormData = locals.formData || {}; %>
            <% const driveError = locals.error || ''; %>
            <% const driveSuccess = locals.success || ''; %>
            <form action="/dang-ky-lai-thu" method="post" class="customer-form">
                <% if (driveError) { %><div class="message error-message"><%= driveError %></div><% } %>
                <% if (driveSuccess) { %><div class="message success-message"><%= driveSuccess %></div><% } %>

                <div class="form-group">
                    <label for="ho_ten">Họ và tên*</label>
                    <input type="text" id="ho_ten" name="ho_ten" required placeholder="Nhập họ và tên" value="<%= driveFormData.ho_ten || '' %>">
                </div>

                <div class="form-group">
                    <label for="email">Email*</label>
                    <input type="email" id="email" name="email" required placeholder="Nhập địa chỉ email" value="<%= driveFormData.email || '' %>">
                </div>

                <div class="form-group">
                    <label for="dien_thoai">Số điện thoại*</label>
                    <input type="tel" id="dien_thoai" name="so_dien_thoai" required placeholder="Nhập số điện thoại" value="<%= driveFormData.so_dien_thoai || '' %>">
                </div>

                <div class="form-group">
                    <label for="mau_xe">Mẫu xe lái thử*</label>
                    <select id="mau_xe" name="mau_xe" required>
                        <option value="">Chọn mẫu xe muốn lái thử</option>
                        <% cars.forEach(car => { %>
                            <option value="<%= car.id %>" <%= String(driveFormData.mau_xe || selectedCarId || '') === String(car.id) ? 'selected' : '' %>><%= car.ten_xe %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="thanh_pho">Tỉnh/Thành phố*</label>
                    <input type="text" id="thanh_pho" name="thanh_pho" required placeholder="Nhập tỉnh hoặc thành phố" value="<%= driveFormData.thanh_pho || '' %>">
                </div>

                <div class="form-group">
                    <label for="dai_ly">Đại lý lái thử*</label>
                    <select id="dai_ly" name="dai_ly" required>
                        <option value="">Chọn đại lý</option>
                        <option value="Double Anh - Hà Nội" <%= driveFormData.dai_ly === 'Double Anh - Hà Nội' ? 'selected' : '' %>>Showroom Double Anh - Hà Nội</option>
                        <option value="Double Anh - TP.HCM" <%= driveFormData.dai_ly === 'Double Anh - TP.HCM' ? 'selected' : '' %>>Showroom Double Anh - TP.HCM</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="ngay_muon_lai">Ngày muốn lái thử</label>
                    <input type="date" id="ngay_muon_lai" name="ngay_muon_lai" value="<%= driveFormData.ngay_muon_lai || '' %>">
                </div>

                <div class="form-group">
                    <label for="gio_muon_lai">Giờ muốn lái thử</label>
                    <input type="time" id="gio_muon_lai" name="gio_muon_lai" value="<%= driveFormData.gio_muon_lai || '' %>">
                </div>

                <div class="form-policy">
                    <label class="checkbox-label">
                        <input type="checkbox" name="dong_y_bao_mat" required>
                        <span>Tôi đồng ý để Showroom Double Anh sử dụng thông tin cá nhân nhằm liên hệ, tư vấn và xử lý yêu cầu lái thử theo chính sách bảo mật.</span>
                    </label>
                    <p class="marketing-consent">Tôi đồng ý nhận thông tin ưu đãi, chương trình bán hàng và dịch vụ chăm sóc khách hàng từ Showroom Double Anh.</p>
                    <div class="radio-group">
                        <label class="radio-label"><input type="radio" name="dong_y_tiep_thi" value="co" required> Có</label>
                        <label class="radio-label"><input type="radio" name="dong_y_tiep_thi" value="khong"> Không</label>
                    </div>
                </div>
                <button type="submit" class="btn primary btn-submit">Gửi lịch lái thử</button>
            </form>
        </div>
    </section>
</main>

<%- include('partials/site-footer') %>

<script src="/javascripts/nav-search.js"></script>
</body>
</html>
