<!-- Floating AI Chatbox Widget -->
<div id="ai-chatbox-widget" class="ai-chatbox-container">
    <!-- Welcome Notification Banner -->
    <div id="chatbox-welcome-banner" class="chatbox-welcome-banner">
        <div class="welcome-banner-content">
            <span class="welcome-kicker">Trợ lý AI Double Anh</span>
            <p>Xin chào! Tôi có thể giúp gì cho bạn về thông tin xe hoặc dịch vụ?</p>
        </div>
        <button id="close-welcome-banner" class="close-welcome-btn">&times;</button>
    </div>

    <!-- Floating Chat Button -->
    <button id="chatbox-toggle-btn" class="chatbox-toggle-btn" aria-label="Mở hộp thoại hỗ trợ">
        <span class="notification-badge" id="chatbox-badge">1</span>
        <svg class="icon-chat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>

    <!-- Chat Box Window -->
    <div id="chatbox-window" class="chatbox-window">
        <!-- Header -->
        <div class="chatbox-header">
            <div class="chatbox-header-info">
                <div class="chatbox-avatar">
                    <img src="/images/logo.png" alt="Double Anh Logo" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                    <span class="avatar-status-dot"></span>
                </div>
                <div>
                    <h4 class="chatbox-title" style="margin: 0; line-height: 1.2;">Trợ lý ảo Double Anh</h4>
                </div>
            </div>
            <button id="chatbox-close-btn" class="chatbox-action-btn" aria-label="Đóng chatbox">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Messages Area -->
        <div id="chatbox-messages" class="chatbox-messages">
            <!-- Messages will be injected by JavaScript -->
        </div>

        <!-- Media Preview Area -->
        <div id="chatbox-media-preview" class="chatbox-media-preview" style="display: none;">
            <div class="preview-container">
                <img id="image-preview" src="#" alt="Xem trước ảnh" style="display: none;" />
                <button id="remove-media-btn" class="remove-media-btn" title="Hủy chọn tệp">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </button>
            </div>
            <span id="preview-filename" class="preview-filename">file.jpg</span>
        </div>

        <!-- Footer / Input Area -->
        <form id="chatbox-input-form" class="chatbox-input-form" onsubmit="return false;">
            <div class="input-actions-wrapper">
                <input type="file" id="chatbox-file-input" accept="image/*" style="display: none;" />
                <button type="button" id="attach-file-btn" class="chatbox-input-btn" title="Đính kèm hình ảnh xe">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                    </svg>
                </button>
                <textarea id="chatbox-textarea" class="chatbox-textarea" placeholder="Nhập câu hỏi về xe hoặc showroom..." rows="1" required></textarea>
                <button type="submit" id="send-chat-btn" class="chatbox-send-btn" title="Gửi tin nhắn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
/* Core Chatbox Design System (Glassmorphic Theme matching Double Anh Showroom) */
.ai-chatbox-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", sans-serif;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

/* Floating Toggle Button */
.chatbox-toggle-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    border: none;
    color: #ffffff;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(2, 132, 199, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.chatbox-toggle-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 35px rgba(2, 132, 199, 0.45), 0 0 15px rgba(2, 132, 199, 0.3);
}

.chatbox-toggle-btn svg {
    width: 26px;
    height: 26px;
    stroke-width: 2;
    transition: transform 0.3s ease;
}

/* Notification Badge */
.notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #f97316; /* Accent orange */
    color: white;
    font-size: 11px;
    font-weight: 800;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 8px rgba(249, 115, 22, 0.4);
    animation: bounce 2s infinite;
}

@keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-6px); }
