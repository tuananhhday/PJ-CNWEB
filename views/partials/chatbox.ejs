<script>
document.addEventListener('DOMContentLoaded', () => {
    const chatboxWidget = document.getElementById('ai-chatbox-widget');
    const toggleBtn = document.getElementById('chatbox-toggle-btn');
    const welcomeBanner = document.getElementById('chatbox-welcome-banner');
    const closeWelcomeBtn = document.getElementById('close-welcome-banner');
    const chatWindow = document.getElementById('chatbox-window');
    const closeWindowBtn = document.getElementById('chatbox-close-btn');
    const messagesContainer = document.getElementById('chatbox-messages');
    const inputForm = document.getElementById('chatbox-input-form');
    const textarea = document.getElementById('chatbox-textarea');
    const fileInput = document.getElementById('chatbox-file-input');
    const attachBtn = document.getElementById('attach-file-btn');
    const mediaPreview = document.getElementById('chatbox-media-preview');
    const imgPreview = document.getElementById('image-preview');
    const previewFilename = document.getElementById('preview-filename');
    const removeMediaBtn = document.getElementById('remove-media-btn');
    const badge = document.getElementById('chatbox-badge');

    let chatHistory = [];
    let currentBase64File = null;
    let currentMimeType = null;

    // Load chat history from sessionStorage
    const savedHistory = sessionStorage.getItem('doubleanh_chat_history');
    if (savedHistory) {
        chatHistory = JSON.parse(savedHistory);
        badge.style.display = 'none'; // Hide badge if they have chatting history
    } else {
        // Initial bot greeting
        chatHistory = [
            {
                role: 'model',
                parts: [{ text: 'Xin chào quý khách! Tôi là trợ lý ảo hỗ trợ trực tuyến của Showroom Double Anh. Tôi có thể giúp bạn giải đáp các thông tin về các mẫu xe (thông số, phiên bản, giá bán) hoặc thông tin hệ thống các đại lý showroom bên tôi. Quý khách cần tư vấn gì ạ?' }]
            }
        ];
        // Show welcome banner after 3 seconds for first-time visitors
        setTimeout(() => {
            if (!chatWindow.classList.contains('is-active')) {
                welcomeBanner.style.opacity = '1';
            }
        }, 3000);
    }

    renderMessages();

    // Toggle Chat Window Open/Close
    toggleBtn.addEventListener('click', () => {
        const isClosed = !chatWindow.classList.contains('is-active');
        if (isClosed) {
            chatWindow.classList.contains('is-active');
            chatWindow.classList.add('is-active');
            welcomeBanner.style.display = 'none';
            badge.style.display = 'none';
            toggleBtn.querySelector('.icon-chat').style.display = 'none';
            toggleBtn.querySelector('.icon-close').style.display = 'block';
            setTimeout(() => messagesContainer.scrollTop = messagesContainer.scrollHeight, 100);
        } else {
            closeChatWindow();
        }
    });

    closeWindowBtn.addEventListener('click', closeChatWindow);

    function closeChatWindow() {
        chatWindow.classList.remove('is-active');
        toggleBtn.querySelector('.icon-chat').style.display = 'block';
        toggleBtn.querySelector('.icon-close').style.display = 'none';
    }

    // Close welcome banner
    closeWelcomeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        welcomeBanner.style.display = 'none';
    });

    // Auto-growing textarea
    textarea.addEventListener('input', () => {
        textarea.style.height = 'auto';
        textarea.style.height = (textarea.scrollHeight) + 'px';
    });

    // Handle Enter to send on Desktop/Laptop, Shift+Enter for newline. Keep default behavior on Mobile.
    textarea.addEventListener('keydown', (e) => {
        const isDesktop = window.innerWidth > 768;
        if (isDesktop && e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            const sendBtn = document.getElementById('send-chat-btn');
            if (sendBtn) {
                sendBtn.click();
            }
        }
    });

    // Trigger file input
    attachBtn.addEventListener('click', () => {
        fileInput.click();
    });

    // Handle File selection
    fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;

        // Size check (Limit to 10MB)
        if (file.size > 10 * 1024 * 1024) {
            alert('Kích thước tệp vượt quá giới hạn 10MB. Vui lòng chọn tệp nhỏ hơn.');
            fileInput.value = '';
            return;
        }

        previewFilename.textContent = file.name;
        currentMimeType = file.type;

        const reader = new FileReader();
        reader.onload = (event) => {
            const result = event.target.result;
            currentBase64File = result.split(',')[1]; // Strip base64 metadata

            if (file.type.startsWith('image/')) {
                imgPreview.src = result;
                imgPreview.style.display = 'block';
            }

            mediaPreview.style.display = 'flex';
        };
        reader.readAsDataURL(file);
    });

    // Remove media selection
    removeMediaBtn.addEventListener('click', () => {
        clearSelectedMedia();
    });

    function clearSelectedMedia() {
        fileInput.value = '';
        currentBase64File = null;
        currentMimeType = null;
        imgPreview.src = '#';
        imgPreview.style.display = 'none';
        mediaPreview.style.display = 'none';
    }

    // Handle Form Submit (Send message)
    inputForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const text = textarea.value.trim();
        if (!text && !currentBase64File) return;

        // Reset text area
        textarea.value = '';
        textarea.style.height = 'auto';

        // Prepare current turn attachment data
        let userPart = { text: text };
        let tempUserMsg = {
            role: 'user',
            text: text,
            mediaBase64: currentBase64File ? `data:${currentMimeType};base64,${currentBase64File}` : null,
            mediaType: currentMimeType
        };

        // Render user message immediately in UI
        renderMessageBubble(tempUserMsg);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Show typing indicator
        showTypingIndicator();

        // 1. Prepare history to send to Gemini API (API cost optimization):
        // We only send plain text representations of previous images/videos in history
        const processedHistory = chatHistory.map(hist => {
            return {
                role: hist.role,
                parts: hist.parts.map(p => ({ text: p.text }))
            };
        });

        // 2. Add current user prompt
        let currentMessageParts = [];
        if (text) {
            currentMessageParts.push({ text: text });
        }
        if (currentBase64File) {
            currentMessageParts.push({
                inlineData: {
                    mimeType: currentMimeType,
                    data: currentBase64File
                }
            });
        }

        // Save plain text representation of this user prompt to local storage history
        let savedUserParts = [];
        let historyPromptText = text;
        if (currentBase64File) {
            historyPromptText += ` [Đã đính kèm: Hình ảnh]`;
        }
        savedUserParts.push({ text: historyPromptText });

        chatHistory.push({
            role: 'user',
            parts: savedUserParts
        });

        // Clear file input immediately
        clearSelectedMedia();

        try {
            // Send payload to backend Express API
            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    messageParts: currentMessageParts,
                    history: processedHistory
                })
            });

            removeTypingIndicator();

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Lỗi server');
            }

            const data = await response.json();
            const botAnswerText = data.text;

            // Render bot bubble
            const botMsg = {
                role: 'model',
                text: botAnswerText
            };
            renderMessageBubble(botMsg);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            // Save to history
            chatHistory.push({
                role: 'model',
                parts: [{ text: botAnswerText }]
            });

            // Save state in session storage
            sessionStorage.setItem('doubleanh_chat_history', JSON.stringify(chatHistory));

        } catch (error) {
            console.error('Lỗi khi gửi tin nhắn chatbox:', error);
            removeTypingIndicator();
            renderMessageBubble({
                role: 'model',
                text: '❌ Có lỗi xảy ra trong quá trình xử lý tin nhắn của bạn. Vui lòng thử lại sau.'
            });
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    });

    // Helper functions for UI rendering
    function renderMessages() {
        messagesContainer.innerHTML = '';
        chatHistory.forEach(msg => {
            const role = msg.role;
            const text = msg.parts && msg.parts[0] ? msg.parts[0].text : '';
            renderMessageBubble({ role, text });
        });
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function renderMessageBubble(msg) {
        const bubble = document.createElement('div');
        bubble.className = `message-bubble ${msg.role}`;

        // Support rendering media attachment if any (only on local instant render)
        if (msg.mediaBase64) {
            if (msg.mediaType.startsWith('image/')) {
                const img = document.createElement('img');
                img.src = msg.mediaBase64;
                bubble.appendChild(img);
            }
        }

        // Parse tables if present in markdown-like format
        let formattedText = msg.text || '';
        
        // Escape HTML to prevent XSS
        const tempDiv = document.createElement('div');
        tempDiv.textContent = formattedText;
        let escapedText = tempDiv.innerHTML;

        // Custom parser for Markdown tables to HTML tables for specifications
        if (escapedText.includes('|') && escapedText.includes('---')) {
            escapedText = parseMarkdownTables(escapedText);
        }

        // Convert newline characters into <br> tags
        escapedText = escapedText.replace(/\n/g, '<br>');

        // Highlight bold words (**bold**)
        escapedText = escapedText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        escapedText = escapedText.replace(/\*(.*?)\*/g, '<em>$1</em>');

        // Convert Markdown links [text](url)
        escapedText = escapedText.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="chatbox-link" target="_blank">$1</a>');

        // Convert standalone relative paths (like /bao-gia, /dang-ky-lai-thu, etc.) into clickable links
        escapedText = escapedText.replace(/(?<!href=["']\/|src=["']\/)(?<![a-zA-Z0-9])(\/(?:bao-gia|dang-ky-lai-thu|tin-tuc|lien-he|danh-sach-xe|trang-chu))(?:\s|<br>|$|[,.!?]|\))/g, '<a href="$1" class="chatbox-link">$1</a>');

        const textSpan = document.createElement('span');
        textSpan.innerHTML = escapedText;
        bubble.appendChild(textSpan);

        // Meta time indicator
        const timeMeta = document.createElement('span');
        timeMeta.className = 'message-meta';
        const now = new Date();
        timeMeta.textContent = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
        bubble.appendChild(timeMeta);

        messagesContainer.appendChild(bubble);
    }

    function showTypingIndicator() {
        const indicator = document.createElement('div');
        indicator.id = 'chatbox-typing-indicator';
        indicator.className = 'message-bubble assistant';
        indicator.style.padding = '8px 12px';

        const wrapper = document.createElement('div');
        wrapper.className = 'typing-indicator';
        for (let i = 0; i < 3; i++) {
            const dot = document.createElement('span');
            dot.className = 'typing-dot';
            wrapper.appendChild(dot);
        }

        indicator.appendChild(wrapper);
        messagesContainer.appendChild(indicator);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function removeTypingIndicator() {
        const indicator = document.getElementById('chatbox-typing-indicator');
        if (indicator) {
            indicator.remove();
        }
    }

    // Direct parser for Markdown-style table inside chatbot answers
    function parseMarkdownTables(text) {
        const lines = text.split('\n');
        let inTable = false;
        let tableHtml = '<table class="chat-table">';
        let newLines = [];
        let tableRows = [];

        lines.forEach(line => {
            const trimmed = line.trim();
            if (trimmed.startsWith('|') && trimmed.endsWith('|')) {
                if (!inTable) {
                    inTable = true;
                    tableRows = [];
                }
                tableRows.push(trimmed);
            } else {
                if (inTable) {
                    inTable = false;
                    tableHtml += renderHtmlTable(tableRows);
                    newLines.push(tableHtml);
                    tableHtml = '<table class="chat-table">';
                }
                newLines.push(line);
            }
        });

        if (inTable) {
            tableHtml += renderHtmlTable(tableRows);
            newLines.push(tableHtml);
        }

        return newLines.join('\n');
    }

    function renderHtmlTable(rows) {
        let html = '';
        // Skip separator line (row index 1 e.g. |---|---|)
        rows.forEach((row, idx) => {
            if (row.includes('---')) return;
            const cells = row.split('|').map(c => c.trim()).filter((c, i, a) => i > 0 && i < a.length - 1);
            html += '<tr>';
            cells.forEach(cell => {
                const tag = idx === 0 ? 'th' : 'td';
                html += `<${tag}>${cell}</${tag}>`;
            });
            html += '</tr>';
        });
        return html + '</table>';
    }
});
</script>
