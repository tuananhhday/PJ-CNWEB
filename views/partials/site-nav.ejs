<header class="site-header">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    <nav class="site-nav" aria-label="Điều hướng chính">
        <a class="brand-mark" href="/trang-chu" aria-label="Trang chủ">
            <img src="/images/logo.png" alt="Logo showroom">
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-menu" id="main-menu">
            <div class="nav-drawer-title">Menu điều hướng</div>
            <div class="nav-item has-menu">
                <a href="/danh-sach-xe">Dòng xe</a>
                <div class="mega-menu">
                    <div class="mega-menu-sidebar">
                        <p class="menu-kicker">Showroom</p>
                        <h3>Khám phá các mẫu xe</h3>
                        <a href="/danh-sach-xe" class="mega-all-cars-btn">Xem tất cả xe có sẵn</a>
                        
                        <div class="mega-menu-types-list">
                            <% 
                            const navTypes = Object.keys(locals.navCarTypes || {});
                            if (navTypes.length > 0) {
                                navTypes.forEach((type, idx) => { 
                            %>
                                <a href="/danh-sach-xe?loai=<%= encodeURIComponent(type) %>" class="mega-type-item-btn <%= idx === 0 ? 'is-active' : '' %>" data-mega-type="<%= type %>">
                                    <%= type %>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M13.1717 12.0007L8.22168 7.05093L9.63589 5.63672L16.0001 12.0009L9.63589 18.3651L8.22168 16.9509L13.1717 12.0007Z"></path>
                                    </svg>
                                </a>
                            <% 
                                });
                            } else { 
                            %>
                                <p style="font-size: 13px; color: var(--text-muted); margin-top: 10px;">Chưa có phân loại xe.</p>
                            <% } %>
                        </div>
                    </div>
                    
                    <div class="mega-menu-content">
                        <% 
                        if (navTypes.length > 0) {
                            Object.entries(locals.navCarTypes).forEach(([type, cars], idx) => { 
                        %>
                            <div class="mega-cars-grid-group <%= idx === 0 ? 'is-active' : '' %>" data-mega-group="<%= type %>">
                                <% cars.slice(0, 4).forEach(car => { %>
                                    <article class="mega-car-card-item">
                                        <a href="/xe/<%= car.duong_dan || car.id %>">
                                            <img src="/images/<%= car.anh_dai_dien || 'no-car.jpg' %>" alt="<%= car.ten_xe %>">
                                            <strong><%= car.ten_xe %></strong>
                                            <span>Xem chi tiết</span>
                                        </a>
                                    </article>
                                <% }); %>
                            </div>
                        <% 
                            });
                        } else { 
                        %>
                            <div class="mega-cars-empty">
                                <p>Không có xe nào đang mở bán.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="nav-item has-menu">
                <a href="/bao-gia">Mua xe</a>
                <div class="dropdown-menu">
                    <a href="/bao-gia">Nhận báo giá</a>
                    <a href="/dang-ky-lai-thu">Đăng ký lái thử</a>
                    <a href="/lien-he">Liên hệ đại lý</a>
                </div>
            </div>
            <a href="/danh-sach-xe">Danh sách xe</a>
            <a href="/tin-tuc">Tin tức</a>
            <a href="/lien-he">Đại lý</a>
            <a href="/admin/xe">Admin</a>
            
            <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-label="Chuyển chế độ sáng/tối">
                <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <span class="theme-toggle-text" style="display: none; margin-left: 8px; font-weight: 500;">Chế độ tối</span>
            </button>

            <div class="nav-search-wrapper" id="nav-search-wrapper">
                <button class="nav-search-trigger" id="nav-search-trigger" type="button" aria-label="Tìm kiếm xe">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z"></path>
                    </svg>
                </button>
                <div class="nav-search-overlay" id="nav-search-overlay">
                    <div class="nav-search-box">
                        <div class="nav-search-input-container">
                            <svg class="search-box-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247L16.0247 15.8748Z"></path>
                            </svg>
                            <input type="text" id="nav-search-input" placeholder="Tìm mẫu xe, phiên bản..." autocomplete="off">
                            <button class="nav-search-close" id="nav-search-close" type="button" aria-label="Đóng tìm kiếm">&times;</button>
                        </div>
                        <div class="nav-search-results" id="nav-search-results"></div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const themeToggle = document.getElementById('theme-toggle');
        const themeToggleText = themeToggle ? themeToggle.querySelector('.theme-toggle-text') : null;
        
        function updateToggleText(theme) {
            if (themeToggleText) {
                themeToggleText.textContent = theme === 'dark' ? 'Giao diện sáng' : 'Giao diện tối';
            }
        }
        
        // Initialize text based on current theme
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        updateToggleText(currentTheme);

        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                const activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
                const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateToggleText(newTheme);
            });
        }
    });
</script>
